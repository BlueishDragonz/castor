# Test environment variables for test_batch4_live.py
# Copy to .env.test and customize for your environment

# Test user email (must exist in the live DB with a passkey)
TEST_USER_EMAIL=test@example.com

# Base URL of the running app (accessible from test runner)
TEST_APP_BASE=http://localhost:8080

# Docker exec prefix for reaching the container
# Use "/usr/bin/docker exec wg-easy" for wg-easy netns, or "docker exec beaverhabits" for direct
DOCKER_EXEC_PREFIX=/usr/bin/docker exec wg-easy

# Source path for castor (if not /opt/castor)
# CASTOR_SRC_PATH=/opt/castor
