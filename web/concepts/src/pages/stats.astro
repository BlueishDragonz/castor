---
/**
 * /stats — per-habit streak cards with 15-week heatmaps.
 * 
 * Matches main branch stats_page.py design:
 * - One card per active habit
 * - Habit name as link to detail page
 * - 15-week readonly heatmap
 * - No aggregate progress bars
 */
import Layout from '../layouts/Layout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '../components/ui/card';
import Heatmap from '../components/Heatmap.astro';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const { email } = Astro.locals.session;

interface Habit {
  id: string;
  name: string;
  records: Array<{
    data: {
      day: string;
      done: boolean;
      timestamp: number;
      text?: string;
    };
  }>;
  status: string;
  period?: { frequency: number; interval: 'day' | 'week' | 'month' } | null;
}

let habits: Habit[] = [];
let loadError: string | null = null;

try {
  // Use the Astro API route which enriches habits with records + detail fields
  const res = await fetch(new URL('/api/v1/habits', Astro.url.origin), {
    headers: { 'Authorization': `Bearer ${Astro.locals.session.token}` },
    credentials: 'include',
  });
  if (res.ok) {
    const habitsList = (await res.json()) as Habit[];
    habits = habitsList.filter((h) => h.status === 'active');
  } else if (res.status !== 404) {
    loadError = `Could not load habits (HTTP ${res.status}).`;
  }
} catch (e) {
  loadError = (e as Error).message;
}

// Read calendar settings from cookies
const firstDayOfWeek = parseInt(Astro.cookies.get('habit_first_day_of_week')?.value || '0', 10);
const alignTodayStr = Astro.cookies.get('habit_align_today')?.value;
const alignToday = alignTodayStr ? parseInt(alignTodayStr, 10) : null;

// Calculate today and heatmap data (same as habit detail page)
const today = new Date();
today.setHours(0, 0, 0, 0);

// Apply alignToday if set
let alignedToday = today;
if (alignToday !== null) {
  const daysUntilAlign = (alignToday - today.getDay() + 7) % 7;
  alignedToday = new Date(today);
  alignedToday.setDate(today.getDate() - daysUntilAlign);
  alignedToday.setHours(0, 0, 0, 0);
}

const WEEKS_TO_DISPLAY = 15;
const DAYS_IN_WEEK = 7;
const heatmapDays: Date[] = [];
const lastWeekday = (firstDayOfWeek + 6) % 7; // Sunday as last day of week
const daysDelta = (lastWeekday - alignedToday.getDay() + 7) % 7;
const lastDateOfCalendar = new Date(alignedToday);
lastDateOfCalendar.setDate(alignedToday.getDate() + daysDelta);

for (let i = 0; i < DAYS_IN_WEEK; i++) {
  for (let j = WEEKS_TO_DISPLAY - 1; j >= 0; j--) {
    const d = new Date(lastDateOfCalendar);
    d.setDate(lastDateOfCalendar.getDate() - i - j * DAYS_IN_WEEK);
    heatmapDays.push(d);
  }
}

// Month headers for heatmap
const heatmapHeaders: string[] = [];
let lastMonth = -1;
let lastYear = -1;
for (const day of heatmapDays.slice(0, DAYS_IN_WEEK)) {
  const curMonth = day.getMonth();
  const curYear = day.getFullYear();
  if (curMonth !== lastMonth) {
    heatmapHeaders.push(day.toLocaleDateString('en-GB', { month: 'short' }));
    lastMonth = curMonth;
    continue;
  }
  if (curYear !== lastYear) {
    heatmapHeaders.push(day.getFullYear().toString());
    lastYear = curYear;
    continue;
  }
  heatmapHeaders.push('');
}

const baseWeekDayAbbr = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const weekDayAbbr = baseWeekDayAbbr.map((_, i) => 
  baseWeekDayAbbr[(i + firstDayOfWeek) % 7]
);

---
<Layout title="Stats — Castor">
  <main class="mx-auto max-w-2xl px-6 py-12 space-y-8">
    <header class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Stats</h1>
        <p class="text-sm text-muted-foreground">
          signed in as {email}
        </p>
      </div>
      <a
        href="/habits"
        class="text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        &larr; Back to habits
      </a>
    </header>

    {loadError && (
      <Card className="border-destructive/50">
        <CardContent className="text-destructive py-4">{loadError}</CardContent>
      </Card>
    )}

    {!loadError && habits.length === 0 && (
      <Card>
        <CardHeader>
          <CardTitle>No stats yet</CardTitle>
          <CardDescription>
            Add a habit to start tracking stats.
          </CardDescription>
        </CardHeader>
      </Card>
    )}

    {!loadError && habits.length > 0 && (
      <div class="space-y-4">
        {habits.map((habit) => (
          <Card key={habit.id} className="overflow-hidden">
            <CardHeader className="pb-2">
              <div class="flex items-center justify-between gap-4">
                <CardTitle className="text-base">
                  <a
                    href={`/habits/${habit.id}`}
                    class="hover:underline text-foreground"
                  >
                    {habit.name}
                  </a>
                </CardTitle>
                {habit.period && (
                  <span class="text-xs text-muted-foreground whitespace-nowrap">
                    {habit.period.frequency}× per {habit.period.interval}
                    {habit.period.frequency > 1 ? 's' : ''}
                  </span>
                )}
              </div>
            </CardHeader>
            <CardContent className="pt-0">
              <Heatmap
                days={heatmapDays}
                tickedDays={habit.records
                  .filter((r) => r.data?.done)
                  .map((r) => r.data?.day?.split('T')[0])
                  .filter(Boolean)}
                headers={heatmapHeaders}
                weekDayAbbr={weekDayAbbr}
                today={today}
                interactive={false}
              />
            </CardContent>
          </Card>
        ))}
      </div>
    )}
  </main>
</Layout>