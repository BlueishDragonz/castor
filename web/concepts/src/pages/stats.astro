---
/**
 * /stats — per-habit streak cards with 15-week heatmaps.
 * 
 * Matches main branch stats_page.py design:
 * - One card per active habit
 * - Habit name as link to detail page
 * - 15-week readonly heatmap
 * - No aggregate progress bars
 */
import Layout from '../layouts/Layout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '../components/ui/card';
import Heatmap from '../components/Heatmap.astro';
import PageHeader from '../components/PageHeader.astro';
import { describePeriod } from '../lib/period';
import type { HabitPeriod } from '../lib/period';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const {} = Astro.locals.session;

interface Habit {
  id: string;
  name: string;
  records: Array<{
    data: {
      day: string;
      done: boolean;
      timestamp: number;
      text?: string;
    };
  }>;
  status: string;
  period?: HabitPeriod | null;
}

let habits: Habit[] = [];
let loadError: string | null = null;

try {
  // Use the Astro API route which enriches habits with records + detail fields
  const res = await fetch(new URL('/api/v1/habits', Astro.url.origin), {
    headers: { 'Authorization': `Bearer ${Astro.locals.session.token}` },
    credentials: 'include',
  });
  if (res.ok) {
    const habitsList = (await res.json()) as Habit[];
    habits = habitsList.filter((h) => h.status === 'active');
  } else if (res.status !== 404) {
    loadError = `Could not load habits (HTTP ${res.status}).`;
  }
} catch (e) {
  loadError = (e as Error).message;
}

// Read calendar settings from cookies
const firstDayOfWeek = parseInt(Astro.cookies.get('habit_first_day_of_week')?.value || '0', 10);
const alignTodayStr = Astro.cookies.get('habit_align_today')?.value;
const alignToday = alignTodayStr ? parseInt(alignTodayStr, 10) : null;

// Calculate today and heatmap data (same as habit detail page)
const today = new Date();
today.setHours(0, 0, 0, 0);

// Apply alignToday if set
let alignedToday = today;
if (alignToday !== null) {
  const daysUntilAlign = (alignToday - today.getDay() + 7) % 7;
  alignedToday = new Date(today);
  alignedToday.setDate(today.getDate() - daysUntilAlign);
  alignedToday.setHours(0, 0, 0, 0);
}

const WEEKS_TO_DISPLAY = 15;
const DAYS_IN_WEEK = 7;
const heatmapDays: Date[] = [];
const lastWeekday = (firstDayOfWeek + 6) % 7; // Sunday as last day of week
const daysDelta = (lastWeekday - alignedToday.getDay() + 7) % 7;
const lastDateOfCalendar = new Date(alignedToday);
lastDateOfCalendar.setDate(alignedToday.getDate() + daysDelta);

for (let i = 0; i < DAYS_IN_WEEK; i++) {
  for (let j = WEEKS_TO_DISPLAY - 1; j >= 0; j--) {
    const d = new Date(lastDateOfCalendar);
    d.setDate(lastDateOfCalendar.getDate() - i - j * DAYS_IN_WEEK);
    heatmapDays.push(d);
  }
}

/**
 * Slice 8 — date-range picker (parity row 3.2).
 *
 * The legacy NiceGUI /stats page let users pick "Last 3/6/12 months" or a
 * custom range, persisted in app.storage.user. The Astro migration branch
 * has no equivalent; this slice adds one.
 *
 * Implementation choice — URL query params (?start=YYYY-MM-DD&end=YYYY-MM-DD)
 * rather than cookies. Query params:
 *   - are stateless (no cookie-clearing on logout)
 *   - support browser back/forward navigation
 *   - share the chosen range by link
 * Defaults: if no query, show ALL records (matches the legacy default).
 */
function isoDate(d: Date): string {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
}
const todayIso = isoDate(new Date());

const url = Astro.url;
const rawStart = url.searchParams.get('start');
const rawEnd = url.searchParams.get('end');

function parseIsoDate(s: string | null): Date | null {
  if (!s) return null;
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
  if (!m) return null;
  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  if (isNaN(d.getTime())) return null;
  return d;
}

const parsedStart = parseIsoDate(rawStart);
const parsedEnd = parseIsoDate(rawEnd);
const validRange =
  parsedStart !== null && parsedEnd !== null && parsedStart <= parsedEnd;
const rangeError: string | null =
  rawStart === null && rawEnd === null
    ? null
    : validRange
      ? null
      : 'Invalid date range';
const startDate = validRange ? parsedStart : null;
const endDate = validRange ? parsedEnd : null;
const rangeActive = startDate !== null && endDate !== null;

/**
 * Apply the chosen range to a habit's record days.
 * - All-time (no range): pass through.
 * - Range active: filter to records within [start, end].
 */
function filterDay(dayIso: string | undefined): string | null {
  if (!dayIso) return null;
  if (!rangeActive) return dayIso;
  const day = dayIso.split('T')[0];
  // startIso/endIso are inclusive on both ends
  if (startDate && day < isoDate(startDate)) return null;
  if (endDate && day > isoDate(endDate)) return null;
  return day;
}

const defaultStart = new Date();
defaultStart.setMonth(defaultStart.getMonth() - 3);
const defaultStartIso = isoDate(defaultStart);

// Month headers for heatmap. `days` is weekday-major (see the loop
// above): days[d*WEEKS+w] is the date for weekday d, week w. We label
// each column by the most-recent day in it — the Sunday (weekday 6)
// that closes the week.
//
// The previous version tracked `lastYear` but never assigned to it, so
// the year branch fired on every week that shared a month with its
// predecessor and the year label was pushed into a random column
// (rendered as a stray "2026" between "Jun" and "Jul"). Month now wins
// when both changed, which is the only case worth labelling.
const heatmapHeaders: string[] = [];
let lastMonth = -1;
for (let w = 0; w < WEEKS_TO_DISPLAY; w++) {
  const d = heatmapDays[(DAYS_IN_WEEK - 1) * WEEKS_TO_DISPLAY + w];
  if (d.getMonth() !== lastMonth) {
    heatmapHeaders.push(d.toLocaleDateString('en-GB', { month: 'short' }));
    lastMonth = d.getMonth();
  } else {
    heatmapHeaders.push('');
  }
}

const baseWeekDayAbbr = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const weekDayAbbr = baseWeekDayAbbr.map((_, i) => 
  baseWeekDayAbbr[(i + firstDayOfWeek) % 7]
);

---
<Layout title="Stats — Castor">
  <main id="main" class="castor-page">
    <PageHeader title="Stats" back="/habits">
      <Fragment slot="actions">
        {rangeActive && (
          <a
            href="/stats"
            class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-accent"
          >
            Clear range
          </a>
        )}
      </Fragment>
    </PageHeader>

    {loadError && (
      <Card className="border-destructive/50">
        <CardContent className="text-destructive py-4">{loadError}</CardContent>
      </Card>
    )}

    {!loadError && habits.length === 0 && (
      <Card>
        <CardHeader>
          <CardTitle as="h2">No stats yet</CardTitle>
          <CardDescription>
            Add a habit to start tracking stats.
          </CardDescription>
        </CardHeader>
      </Card>
    )}

    {!loadError && habits.length > 0 && (
      <div class="castor-stack">
        {/*
          A legend, because the heatmap encodes state purely as colour.
          Without it a first-time reader cannot tell "not done" from
          "outside the window" from "loading". The labels are text, so
          the meaning does not depend on perceiving the swatches.
        */}
        <div class="stats-legend" aria-label="Heatmap key">
          <span class="stats-legend__label">Key</span>
          <span class="stats-legend__item">
            <span class="stats-legend__swatch is-done" aria-hidden="true"></span>
            Completed
          </span>
          <span class="stats-legend__item">
            <span class="stats-legend__swatch is-missed" aria-hidden="true"></span>
            Not completed
          </span>
          <span class="stats-legend__item">
            <span class="stats-legend__swatch is-today" aria-hidden="true"></span>
            Today
          </span>
        </div>
        {/*
          One <form> wrapping all three controls, so the range picker
          submits as a single unit and the Preset select can carry the
          start/end it computes instead of navigating on its own. The
          previous markup nested a <form> inside a plain <div> that
          itself sat inside the legend/panel, so the preset dropdown and
          the date fields were two disconnected controls.
        */}
        <form method="get" class="stats-range" data-testid="date-range-picker">
          <div class="stats-range__field">
            <label for="preset-start" class="stats-range__label">Quick range</label>
            <select
              id="preset-start"
              name="preset"
              class="stats-range__control"
              onchange="
                const v = this.value;
                if (!v) return;
                const today = new Date();
                const start = new Date(today);
                if (v === '3m') start.setMonth(today.getMonth() - 3);
                else if (v === '6m') start.setMonth(today.getMonth() - 6);
                else if (v === '12m') start.setMonth(today.getMonth() - 12);
                else if (v === '24m') start.setFullYear(today.getFullYear() - 2);
                else return;
                // Local-date formatting. toISOString() converts to UTC,
                // which shifts the day for anyone east or west of
                // Greenwich and made the preset land a day off the one
                // the user asked for.
                const fmt = d =>
                  d.getFullYear() + '-' +
                  String(d.getMonth() + 1).padStart(2, '0') + '-' +
                  String(d.getDate()).padStart(2, '0');
                this.form.start.value = fmt(start);
                this.form.end.value = fmt(today);
                this.form.submit();
              "
            >
              <option value="">Choose a range</option>
              <option value="3m">Last 3 months</option>
              <option value="6m">Last 6 months</option>
              <option value="12m">Last 12 months</option>
              <option value="24m">Last 24 months</option>
            </select>
          </div>

          <div class="stats-range__field">
            <label for="start" class="stats-range__label">From</label>
            <input
              type="date"
              id="start"
              name="start"
              value={rawStart ?? ''}
              max={rawEnd ?? todayIso}
              class="stats-range__control"
            />
          </div>

          <div class="stats-range__field">
            <label for="end" class="stats-range__label">To</label>
            <input
              type="date"
              id="end"
              name="end"
              value={rawEnd ?? ''}
              min={rawStart ?? ''}
              max={todayIso}
              class="stats-range__control"
            />
          </div>

          <div class="stats-range__actions">
            <button
              type="submit"
              class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Apply range
            </button>
            {rangeActive && (
              <a
                href="/stats"
                class="inline-flex h-10 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors hover:bg-accent"
              >
                Clear
              </a>
            )}
          </div>
        </form>
        {rangeError && (
          <div
            class="rounded-md border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive"
            role="alert"
          >
            {rangeError}
          </div>
        )}

        {habits.map((habit) => {
          /*
           * The period used to be interpolated as
           * `{habit.period.frequency}× per {habit.period.interval}`,
           * but the backend sends period_type/period_count/target_count.
           * Both properties were undefined, so the card header rendered a
           * bare "× per " with nothing before or after it (verified in
           * the DOM: <span>× per </span>). describePeriod() speaks the
           * backend's shape.
           */
          const periodLabel = describePeriod(habit.period);
          return (
          <Card className="overflow-hidden">
            <CardHeader className="pb-3">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <CardTitle as="h2" className="text-base">
                  <a
                    href={`/habits/${habit.id}`}
                    class="hover:underline text-foreground"
                  >
                    {habit.name}
                  </a>
                </CardTitle>
                {periodLabel && (
                  <span class="text-xs text-muted-foreground whitespace-nowrap">
                    {periodLabel}
                  </span>
                )}
              </div>
            </CardHeader>
            <CardContent className="pt-0">
              <Heatmap
                days={heatmapDays}
                tickedDays={habit.records
                  .filter((r) => r.data?.done)
                  .map((r) => filterDay(r.data?.day))
                  .filter(Boolean) as string[]}
                headers={heatmapHeaders}
                weekDayAbbr={weekDayAbbr}
                today={today}
                interactive={false}
              />
            </CardContent>
          </Card>
          );
        })}
      </div>
    )}
  </main>
</Layout>

<style>
  .stats-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .stats-legend__label {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .stats-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Swatches mirror the Heatmap component's own cell colours. */
  .stats-legend__swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .stats-legend__swatch.is-done {
    background: color-mix(in oklab, var(--primary) 80%, transparent);
    border-color: transparent;
  }

  .stats-legend__swatch.is-missed {
    background: color-mix(in oklab, var(--muted) 100%, transparent);
  }

  .stats-legend__swatch.is-today {
    background: transparent;
    border-color: var(--primary);
    box-shadow: 0 0 0 1px var(--primary);
  }

  /*
   * The range picker. The three controls are one logical group, so they
   * sit on a single row that wraps at narrow widths, share one control
   * height, and put their actions last.
   */
  .stats-range {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--muted);
  }

  .stats-range__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stats-range__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .stats-range__control {
    height: 2.5rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--control-border);
    border-radius: 0.375rem;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.875rem;
  }

  .stats-range__actions {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .stats-range__field,
    .stats-range__control {
      width: 100%;
    }

    .stats-range__actions {
      width: 100%;
      margin-left: 0;
    }

    .stats-range__actions > * {
      flex: 1;
    }
  }
</style>