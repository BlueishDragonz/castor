---
/**
 * Security page — matches main branch security_page.py
 * 
 * Renders the React SecurityContent component as a client island
 */
import Layout from '../layouts/Layout.astro';
import { SecurityContent } from '../components/SecurityContent.tsx';
import PageHeader from '../components/PageHeader.astro';
import { DesktopMenu } from '../components/DesktopMenu.tsx';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}
---

<Layout title="Security">
  {/*
    F7: this page used to do
      <script define:vars={{ token }}>window.__SECURITY_TOKEN__ = token</script>
    to hand the session JWT to SecurityContent.tsx, which read it at six call
    sites and attached it as an `Authorization` header from client JavaScript.
    That made the httpOnly cookie design decorative: any XSS anywhere in the
    app would yield a 30-day bearer token.

    SecurityContent now calls the same-origin `/api/v1/webauthn/*` BFF
    instead, and that BFF attaches the bearer server-side from the httpOnly
    cookie. The token is no longer rendered into the page at all, so the
    original `is:inline` interpolation problem cannot recur — there is nothing
    left to interpolate.
  */}
  <main class="mx-auto max-w-2xl px-6 py-12 space-y-6 pb-24">
    <PageHeader title="Security" back="/habits">
      <DesktopMenu slot="actions" client:load email={Astro.locals.session.email} />
    </PageHeader>
    <SecurityContent client:load />
  </main>
</Layout>