---
/**
 * Security page — matches main branch security_page.py
 * 
 * Renders the React SecurityContent component as a client island
 */
import Layout from '../layouts/Layout.astro';
import { SecurityContent } from '../components/SecurityContent.tsx';
import PageHeader from '../components/PageHeader.astro';
import { DesktopMenu } from '../components/DesktopMenu.tsx';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const token = Astro.locals.session.token;
---

<Layout title="Security">
  {/*
    Slice 22x: was `<script is:inline>window.__SECURITY_TOKEN__ = '{token}'</script>`
    but `is:inline` emits the script body verbatim — the `{token}` literal
    was sent down the wire unchanged and SecurityContent.tsx's early
    `if (!token) return;` skipped fetchData entirely, leaving the page
    stuck on "Loading...". `define:vars` runs Astro interpolation before
    the script is serialised, so the actual JWT lands on the page.

    TODO: long term, move the React island's auth off window globals
    entirely — the BFF already exposes cookie-authenticated webauthn
    endpoints, so the fetch can just call `/api/v1/webauthn/*` same-origin.
  */}
  <script define:vars={{ token }}>
    /* eslint-disable */
    window.__SECURITY_TOKEN__ = token;
  </script>
  <main class="mx-auto max-w-2xl px-6 py-12 space-y-6 pb-24">
    <PageHeader title="Security" back="/habits">
      <DesktopMenu slot="actions" client:load email={Astro.locals.session.email} />
    </PageHeader>
    <SecurityContent client:load />
  </main>
</Layout>