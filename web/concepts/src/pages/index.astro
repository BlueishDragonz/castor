---
/**
 * Home page — signed-out landing / shop front.
 *
 * Proxies a /health check to the backend to display the connection
 * state in the footer (small monospace line — see the rendered HTML
 * for the "Server: ok · /health → OK · v0.x.x · MIT · source" line).
 * The status is intentionally NOT in the hero: the hero is reserved
 * for the value proposition and the CTA. Signed-in users get bounced
 * to /habits.
 *
 * The /health endpoint lives at the backend root (not under /api/v1)
 * because it is mounted by main.py directly on the FastAPI app. We
 * probe it through the same-origin proxy chain (Astro server -> Vite
 * proxy in dev / reverse proxy in production).
 */
import Layout from '../layouts/PublicLayout.astro';
import { backendFetch } from '../lib/auth';

if (Astro.locals.session) {
  return Astro.redirect('/habits');
}

let backendStatus: 'ok' | 'down' | 'unknown' = 'unknown';
let backendMessage = 'unreachable';

try {
  const res = await backendFetch(Astro.cookies, '/health', {
    signal: AbortSignal.timeout(3000),
  });
  if (res.ok) {
    backendStatus = 'ok';
    backendMessage = (await res.text()).trim() || 'OK';
  } else {
    backendStatus = 'down';
    backendMessage = `HTTP ${res.status}`;
  }
} catch (e) {
  backendStatus = 'down';
  backendMessage = (e as Error).message;
}
---

<Layout title="Castor — Dam good habits">
  <main class="mx-auto max-w-2xl px-6 py-16 flex flex-col gap-8">

    {/* ─── Hero ─── */}
    <section class="space-y-6 pt-4">
      <div class="flex items-center gap-3">
        <div
          class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground"
          style="background: var(--castor-emblem-bg-primary); border-radius: var(--castor-emblem-radius);"
        >
          C
        </div>
        <span class="text-xl font-semibold tracking-tight">Castor</span>
      </div>

      <h1 class="text-5xl sm:text-6xl font-semibold tracking-tight leading-[1.05]">
        Dam good habits.
      </h1>

      <p class="text-lg text-muted-foreground max-w-prose">
        A self-hosted habit tracker for people who want their data to stay theirs.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/register"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-6"
        >Create an account</a>
        <a
          href="/login"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 px-6"
        >Sign in</a>
      </div>
    </section>

    {/* ─── What it does (feature cards) ─── */}
    <section class="space-y-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        What it does
      </h2>

      <div class="grid gap-4 sm:grid-cols-3">
        <article
          class="rounded-2xl border border-border bg-card p-5 space-y-2"
          style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
        >
          <h3 class="font-semibold">Daily check-ins</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Tick the boxes that match what you actually did today.
            No streaks designed to shame you for a sick day.
          </p>
        </article>

        <article
          class="rounded-2xl border border-border bg-card p-5 space-y-2"
          style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
        >
          <h3 class="font-semibold">Streaks that hold up</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            See the calendar, see the run, see when you lapsed.
            The numbers are honest.
          </p>
        </article>

        <article
          class="rounded-2xl border border-border bg-card p-5 space-y-2"
          style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
        >
          <h3 class="font-semibold">Private Circles</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Share a habit with the people you live with.
            They see what you choose. Nothing more.
          </p>
        </article>
      </div>
    </section>

    {/* ─── Why people pick Castor ─── */}
    <section
      class="rounded-2xl border border-border bg-card p-6 space-y-4"
      style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
    >
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        Why people pick Castor
      </h2>

      <ul class="space-y-4 text-base leading-relaxed">
        <li>
          <span class="font-semibold">Private by default.</span>
          <span class="text-muted-foreground">
            {' '}Your data lives on a server you control. No analytics,
            no telemetry, no ads, no third-party fonts.
          </span>
        </li>
        <li>
          <span class="font-semibold">Yours forever.</span>
          <span class="text-muted-foreground">
            {' '}Export your habits, ticks, and notes to JSON anytime.
            Re-import on another server. No lock-in.
          </span>
        </li>
        <li>
          <span class="font-semibold">Made for showing up, not for streaks.</span>
          <span class="text-muted-foreground">
            {' '}Miss a day? The streak doesn't reset in a way designed
            to hurt you. The goal is the practice, not the streak.
          </span>
        </li>
      </ul>
    </section>

    {/* ─── What people make with it (examples) ─── */}
    <section
      class="rounded-2xl border border-border bg-card p-6 space-y-4"
      style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
    >
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        What people make with it
      </h2>

      <ul class="space-y-3 text-sm">
        <li class="flex items-baseline gap-3">
          <span class="text-muted-foreground">·</span>
          <span><em>Morning pages before coffee</em> — 1 habit, 14-day streak</span>
        </li>
        <li class="flex items-baseline gap-3">
          <span class="text-muted-foreground">·</span>
          <span><em>Two walks with the dog</em> — 2 habits, 90-day streak</span>
        </li>
        <li class="flex items-baseline gap-3">
          <span class="text-muted-foreground">·</span>
          <span><em>Family hydration</em> — 3 people, 1 shared habit, weekly wins</span>
        </li>
      </ul>
    </section>

    {/* ─── On self-hosting ─── */}
    <section
      class="rounded-2xl border border-border bg-card p-6 space-y-3"
      style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
    >
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        On self-hosting
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed max-w-prose">
        Castor runs in a single Docker container on anything that runs containers.
      </p>
    </section>

  </main>

  {/* ─── Footer (server status badge + project links) ───
      Small inline badge in the bottom-left corner. The word "Status"
      is always visible (so it's discoverable, not just an anonymous
      dot); the colour encodes the state (green = up, red = down,
      amber = unknown). A `title` attribute exposes the full /health
      response for ops-minded visitors who hover. */}
  <footer class="mx-auto max-w-2xl px-6 pb-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span
        class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium"
        style={`background: ${
          backendStatus === 'ok'
            ? 'color-mix(in oklab, var(--positive) 12%, transparent)'
            : backendStatus === 'down'
              ? 'color-mix(in oklab, var(--destructive) 12%, transparent)'
              : 'color-mix(in oklab, var(--destructive) 8%, transparent)'
        }; color: ${
          backendStatus === 'ok' ? 'var(--positive)' : 'var(--destructive)'
        }; border-color: ${
          backendStatus === 'ok'
            ? 'color-mix(in oklab, var(--positive) 30%, transparent)'
            : 'color-mix(in oklab, var(--destructive) 30%, transparent)'
        };`}
        title={`Server ${backendStatus} · /health → ${backendMessage}`}
        aria-label={`Server status: ${backendStatus}`}
      >
        <span
          class="inline-block h-1.5 w-1.5 rounded-full"
          style={`background: ${
            backendStatus === 'ok' ? 'var(--positive)' : 'var(--destructive)'
          };`}
        ></span>
        Status
      </span>
      <nav class="flex gap-4 text-xs text-muted-foreground font-sans">
        <a href="/help" class="hover:underline">Help</a>
        <a href="/terms" class="hover:underline">Terms</a>
        <a href="/privacy" class="hover:underline">Privacy</a>
      </nav>
    </div>
  </footer>
</Layout>
