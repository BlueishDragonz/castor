---
/**
 * Home page — signed-out landing.
 *
 * Proxies a /health check to the backend to show the connection state.
 * Signed-in users get bounced to /habits.
 *
 * The /health endpoint lives at the backend root (not under /api/v1)
 * because it is mounted by main.py directly on the FastAPI app. We
 * probe it through the same-origin proxy chain (Astro server -> Vite
 * proxy in dev / reverse proxy in production).
 */
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { backendFetch } from '../lib/auth';

if (Astro.locals.session) {
  return Astro.redirect('/habits');
}

let backendStatus: 'ok' | 'down' | 'unknown' = 'unknown';
let backendMessage = 'unreachable';

try {
  const res = await backendFetch(Astro.cookies, '/health', {
    signal: AbortSignal.timeout(3000),
  });
  if (res.ok) {
    backendStatus = 'ok';
    backendMessage = await res.text();
  } else {
    backendStatus = 'down';
    backendMessage = `HTTP ${res.status}`;
  }
} catch (e) {
  backendStatus = 'down';
  backendMessage = (e as Error).message;
}
---

<Layout title="Castor">
  <main class="mx-auto max-w-2xl px-6 py-16 space-y-8">
    <div class="flex items-center gap-3">
      <div
        class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground"
        style="background: var(--castor-emblem-bg-primary); border-radius: var(--castor-emblem-radius);"
      >
        C
      </div>
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Castor</h1>
        <p class="text-sm text-muted-foreground">
          Privacy-first habit tracker · shadcn/ui + Astro
        </p>
      </div>
    </div>

    <section
      class="rounded-2xl border border-border bg-card p-6 shadow-sm"
      style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
    >
      <h2 class="mb-2 text-lg font-semibold">Backend connection</h2>
      <div class="flex items-center gap-3 text-sm">
        <span
          class="inline-block h-2.5 w-2.5 rounded-full"
          style={`background: ${
            backendStatus === 'ok' ? 'var(--positive)' : 'var(--destructive)'
          };`}
        />
        <span class="font-medium">
          {backendStatus === 'ok' ? 'Connected' : 'Unavailable'}
        </span>
        <code class="text-xs text-muted-foreground">/health → {backendMessage}</code>
      </div>
    </section>

    <section
      class="rounded-2xl border border-border bg-card p-6 shadow-sm"
      style="border-radius: var(--castor-card-radius); padding: var(--castor-card-padding);"
    >
      <h2 class="mb-3 text-lg font-semibold">What you can do here</h2>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li>✓ Register a new account and sign in</li>
        <li>✓ Add habits to your private list</li>
        <li>✓ Mark habits done each day</li>
        <li>✓ Sign out and clear your session</li>
        <li>○ Concepts 02/04/09 (Cue Atlas, Memory Drawer, Private Circle) — coming next</li>
        <li>○ PWA shell, dark mode parity, OAuth — coming next</li>
      </ul>
      <div class="mt-5 flex gap-3">
        <Button asChild>
          <a href="/login">Sign in</a>
        </Button>
        <Button variant="outline" asChild>
          <a href="/register">Create account</a>
        </Button>
      </div>
    </section>
  </main>
</Layout>
