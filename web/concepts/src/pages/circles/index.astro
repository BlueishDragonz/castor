---
/**
 * /circles — list of circles the user owns or belongs to.
 *
 * Server-rendered. Fetches via /api/v1/circles (authenticated) and
 * renders a card per circle with create-cta in the page header.
 */
import Layout from '../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '../../components/ui/card';
import { buttonVariants } from '../../components/ui/button';
import { Crown } from 'lucide-react';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { backendFetch } from '../../lib/auth';
import type { CircleSummary } from '../../lib/circles';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

let circles: CircleSummary[] = [];
let error: string | null = null;

try {
  const res = await backendFetch(Astro.cookies, '/api/v1/circles', { method: 'GET' });
  if (res.ok) {
    circles = await res.json();
  } else if (res.status !== 404) {
    error = `Could not load circles (HTTP ${res.status})`;
  }
} catch (e) {
  error = (e as Error).message;
}
---

<Layout title="Private Circles">
  <main id="main" class="castor-page">
    <PageHeader title="Circles" subtitle="Small, trusted groups that see each other's habit ticks. Membership requires an invite.">
      <Fragment slot="actions">
        {/*
          A plain <a> with the Button's class string rather than
          `<Button asChild><a/></Button>`: inside a .astro file the
          Radix Slot does not merge the cva classes onto the child, so
          the link rendered with no button styling at all — it looked
          like body text. buttonVariants() gives the same classes
          without the Slot round-trip.
        */}
        <a href="/circles/new" class={buttonVariants()}>
          New circle
        </a>
      </Fragment>
    </PageHeader>

    {error && (
      <Card className="w-full border-destructive">
        <CardContent className="py-4">
          <p class="text-sm text-destructive">{error}</p>
        </CardContent>
      </Card>
    )}

    {/*
      No CTA in the empty state: the "New circle" button in the header
      is the one action this screen offers, and the empty state
      previously repeated it as a second primary link directly beneath.
    */}
    {!error && circles.length === 0 && (
      <EmptyState
        title="You don't belong to any circles yet"
        description="A circle is an invite-only group. You create one, invite the people you trust, and choose which habits they can see. Nobody else can find it."
      />
    )}

    {circles.length > 0 && (
      <div class="space-y-3">
        {circles.map(c => (
          <Card className="w-full">
            <CardHeader className="pb-2">
              <CardTitle as="h2" className="text-base font-medium flex items-center gap-2">
                {c.is_owner && <Crown className="h-4 w-4 text-amber-500" aria-hidden="true" />}
                <a href={`/circles/${c.id}`} class="hover:underline">
                  {c.name}
                </a>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-0 text-sm text-muted-foreground">
              {c.member_count} member{c.member_count === 1 ? '' : 's'}
              {' · '}
              {c.shared_habit_count} shared habit{c.shared_habit_count === 1 ? '' : 's'}
              {' · '}
              created {new Date(c.created_at).toLocaleDateString('en-GB')}
            </CardContent>
          </Card>
        ))}
      </div>
    )}
  </main>
</Layout>
