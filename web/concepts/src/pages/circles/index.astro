---
/**
 * /circles — list of circles the user owns or belongs to.
 *
 * Server-rendered. Fetches via /api/v1/circles (authenticated) and
 * renders a card per circle with create-cta in the page header.
 */
import Layout from '../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Crown } from 'lucide-react';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { backendFetch } from '../../lib/auth';
import type { CircleSummary } from '../../lib/circles';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

let circles: CircleSummary[] = [];
let error: string | null = null;

try {
  const res = await backendFetch(Astro.cookies, '/api/v1/circles', { method: 'GET' });
  if (res.ok) {
    circles = await res.json();
  } else if (res.status !== 404) {
    error = `Could not load circles (HTTP ${res.status})`;
  }
} catch (e) {
  error = (e as Error).message;
}
---

<Layout title="Private Circles">
  <main class="mx-auto max-w-2xl px-4 py-12 space-y-4 pb-24">
    <PageHeader title="Private Circles" subtitle="Small, trusted groups that see each other's habit ticks. Membership requires an invite.">
      <Button slot="actions" asChild>
        <a href="/circles/new" aria-label="Create new circle">New circle</a>
      </Button>
    </PageHeader>

    {error && (
      <Card className="w-full border-destructive">
        <CardContent className="py-4">
          <p class="text-sm text-destructive">{error}</p>
        </CardContent>
      </Card>
    )}

    {!error && circles.length === 0 && (
      <EmptyState
        title="You don't belong to any circles yet."
        description="Create one to share habit ticks with a small, trusted group."
        ctaHref="/circles/new"
        ctaLabel="Create your first circle"
      />
    )}

    {circles.length > 0 && (
      <div class="space-y-3">
        {circles.map(c => (
          <Card className="w-full">
            <CardHeader className="pb-2">
              <CardTitle className="text-base font-medium flex items-center gap-2">
                {c.is_owner && <Crown className="h-4 w-4 text-amber-500" aria-hidden="true" />}
                <a href={`/circles/${c.id}`} class="hover:underline">
                  {c.name}
                </a>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-0 text-sm text-muted-foreground">
              {c.member_count} member{c.member_count === 1 ? '' : 's'}
              {' · '}
              {c.shared_habit_count} shared habit{c.shared_habit_count === 1 ? '' : 's'}
              {' · '}
              created {new Date(c.created_at).toLocaleDateString('en-GB')}
            </CardContent>
          </Card>
        ))}
      </div>
    )}
  </main>
</Layout>
