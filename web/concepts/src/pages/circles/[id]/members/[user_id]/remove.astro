---
/**
 * /circles/{id}/members/{user_id}/remove — owner removes a member.
 */
import { backendFetch } from '../../../../../lib/auth';

if (!Astro.locals.session) return Astro.redirect('/login');
const { id, user_id } = Astro.params;
if (!id || !user_id) return Astro.redirect('/circles');
const circleId = Number(id);
if (!Number.isFinite(circleId)) return Astro.redirect('/circles');

if (Astro.request.method !== 'POST') {
  return Astro.redirect(`/circles/${circleId}`);
}

const res = await backendFetch(Astro.cookies, `/api/v1/circles/${circleId}/members/${user_id}`, {
  method: 'DELETE',
});

if (!res.ok) {
  return Astro.redirect(`/circles/${circleId}?err=remove_failed`);
}

return Astro.redirect(`/circles/${circleId}`);
---
