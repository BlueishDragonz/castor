---
/**
 * /circles/{id} — circle detail (owner or member view).
 *
 * Renders:
 *   - Header: circle name + crown if owner
 *   - Members section
 *   - Shared habits section (slice 24d: split into "Yours" and "Members"
 *     so the owner can manage their own shares while seeing attribution
 *     for shares from other members)
 *   - Pending invites section (owner only) + new invite form
 *   - Feed section (slice 24d: now for both owners and members): per-shared-habit
 *     ticks + streak + notes, with each entry keyed by its actual
 *     owner_email
 *
 * Forms are server-side POSTs:
 *   - /circles/{id}/invites  (POST, owner only): mint invite
 *   - /circles/{id}/habits/{hid} (DELETE, owner only): unshare
 *   - /circles/{id}/members/{uid} (DELETE, owner or self): remove
 *   - /circles/{id}/share     (POST, owner only): share a habit
 *   - /circles/{id}/leave     (POST, member only): leave
 *   - /circles/{id}/delete    (POST, owner only): delete circle
 *
 * Slice 23b: copyable invite URL on mint; crown icon is decorative
 * (aria-hidden); invite form is stacked (FormActions); destructive
 * action is de-emphasised, not promoted; ?err= banners via ErrorBanner.
 */
import Layout from '../../../layouts/Layout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardContent,
} from '../../../components/ui/card';
import { Button } from '../../../components/ui/button';
import { Input } from '../../../components/ui/input';
import { Label } from '../../../components/ui/label';
import { Badge } from '../../../components/ui/badge';
import PageHeader from '../../../components/PageHeader.astro';
import FormActions from '../../../components/FormActions.astro';
import ErrorBanner from '../../../components/ErrorBanner.astro';
import {
  Crown,
  Users,
  Trash2,
  Copy,
} from 'lucide-react';
import { backendFetch } from '../../../lib/auth';
import { VISIBILITY_LABEL, VISIBILITY_DESCRIPTION } from '../../../lib/circles';
import type {
  CircleDetail,
  CircleInvite,
  CircleFeedHabit,
} from '../../../lib/circles';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/circles');
}

const circleId = Number(id);
if (!Number.isFinite(circleId)) {
  return Astro.redirect('/circles');
}

let circle: CircleDetail | null = null;
let invites: CircleInvite[] = [];
let feed: CircleFeedHabit[] = [];
let myHabits: Array<{ id: string; name: string }> = [];
let error: string | null = null;

const headers = { Accept: 'application/json' };

try {
  const detailRes = await backendFetch(
    Astro.cookies,
    `/api/v1/circles/${circleId}`,
    { method: 'GET', headers },
  );
  if (detailRes.status === 403 || detailRes.status === 404) {
    return Astro.redirect('/circles?err=forbidden');
  }
  if (!detailRes.ok) {
    error = `Could not load circle (HTTP ${detailRes.status})`;
  } else {
    circle = (await detailRes.json()) as CircleDetail;
  }
} catch (e) {
  error = (e as Error).message;
}

if (circle) {
  // Slice 24d: fetch /feed for everyone, not just members. The owner
  // now needs to see what their circle members have shared (and what
  // activity has happened). Member-shared habits also appear in
  // circle.shared_habits, but the feed is the rendered view.
  try {
    const feedRes = await backendFetch(
      Astro.cookies,
      `/api/v1/circles/${circleId}/feed?days=14`,
      { method: 'GET', headers },
    );
    if (feedRes.ok) feed = (await feedRes.json()) as CircleFeedHabit[];
  } catch {}
  if (circle.is_owner) {
    try {
      const invRes = await backendFetch(
        Astro.cookies,
        `/api/v1/circles/${circleId}/invites`,
        { method: 'GET', headers },
      );
      if (invRes.ok) invites = (await invRes.json()) as CircleInvite[];
    } catch {}
  }
}

// Load my habits so the owner can pick which one to share.
if (circle?.is_owner) {
  try {
    const habitsRes = await backendFetch(
      Astro.cookies,
      '/api/v1/habits',
      { method: 'GET', headers },
    );
    if (habitsRes.ok) myHabits = (await habitsRes.json()) as Array<{ id: string; name: string }>;
  } catch {}
}

// One-shot invite token shown after the owner mints a new invite. The
// invites.astro POST handler redirects here with ?new_invite=ID and
// ?new_token=RAW; slice 23a also adds ?new_invite_url=... so the
// inviter sees a single copy-pasteable URL.
const newInviteIdRaw = Astro.url.searchParams.get('new_invite');
const newToken = Astro.url.searchParams.get('new_token') ?? '';
const newInviteUrl = Astro.url.searchParams.get('new_invite_url') ?? '';
const newInviteId = newInviteIdRaw ? Number(newInviteIdRaw) : NaN;
// Prefer the server-built URL (slice 23a); fall back to assembling one
// ourselves if only the token was returned.
const inviteUrl = newInviteUrl
  ? newInviteUrl
  : newToken
    ? `${Astro.url.origin}/circles/${circleId}/join?token=${encodeURIComponent(newToken)}`
    : '';
---

<Layout title={circle ? circle.name : 'Circle'}>
  <main id="main" class="castor-page">
    <ErrorBanner />

    {circle && (
      <PageHeader
        title={circle.name}
        subtitle={`${circle.members.length} member${circle.members.length === 1 ? '' : 's'}`}
        back="/circles"
      >
        <span slot="title" class="inline-flex items-center gap-2 min-w-0">
          {circle.is_owner && <Crown className="h-5 w-5 text-amber-500" aria-hidden="true" />}
          <span class="truncate">{circle.name}</span>
        </span>
      </PageHeader>
    )}

    {error && (
      <Card className="w-full border-destructive">
        <CardContent className="py-4">
          <p class="text-sm text-destructive">{error}</p>
        </CardContent>
      </Card>
    )}

    {inviteUrl && Number.isFinite(newInviteId) && (
      <Card className="w-full border-amber-500/50 bg-amber-50/50 dark:bg-amber-950/20">
        <CardHeader className="pb-2">
          <CardTitle as="h2" className="text-base font-medium">Invite link ready</CardTitle>
        </CardHeader>
        <CardContent className="pt-0 space-y-3">
          <p class="text-sm text-muted-foreground">
            Send this link to the person you want to invite. Anyone with
            the link can join until it expires.
          </p>
          <div class="flex flex-col sm:flex-row gap-2">
            <Input
              id="new-invite-url"
              value={inviteUrl}
              readOnly
              aria-readonly="true"
              aria-label="Invite URL"
              className="font-mono text-xs"
              data-testid="new-invite-url"
            />
            <Button
              type="button"
              variant="outline"
              className="shrink-0"
              data-copy-target="new-invite-url"
              data-copy-original="Copy link"
            >
              <Copy className="h-4 w-4 mr-1" aria-hidden="true" />
              <span data-copy-label-text>Copy link</span>
            </Button>
          </div>
          <p class="text-xs text-muted-foreground">
            The token is shown here once and never again. Copy it now or
            send the link yourself — the backend doesn't email it.
          </p>
        </CardContent>
      </Card>
    )}

    {circle && (
      <>
        <!-- Members -->
        <Card className="w-full">
          <CardHeader className="pb-2">
            <CardTitle as="h2" className="text-base font-medium flex items-center gap-2">
              <Users className="h-4 w-4" aria-hidden="true" />
              Members ({circle.members.length})
            </CardTitle>
          </CardHeader>
          <CardContent className="pt-0">
            <ul class="divide-y divide-border" role="list">
              {circle.members.map(m => (
                <li class="py-2 flex items-center gap-2 text-sm">
                  {m.is_owner && <Crown className="h-4 w-4 text-amber-500" aria-hidden="true" />}
                  <span class="font-medium">{m.email}</span>
                  {!m.is_owner && circle.is_owner && (
                    <form method="post" action={`/circles/${circleId}/members/${m.user_id}/remove`} class="ml-auto">
                      <Button type="submit" variant="ghost" size="icon" aria-label={`Remove ${m.email}`}>
                        <Trash2 className="h-4 w-4" aria-hidden="true" />
                      </Button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>

        <!-- Shared habits — slice 24d: split into "your shares" (manageable)
             and "members' shares" (read-only with attribution). -->
        <Card className="w-full">
          <CardHeader className="pb-2">
            <CardTitle as="h2" className="text-base font-medium">
              Shared habits ({circle.shared_habits.length})
            </CardTitle>
          </CardHeader>
          <CardContent className="pt-0">
            {(() => {
              // Slice 24e: split "your shares" (rows this viewer owns)
              // from "members' shares" (everyone else in this circle).
              // The viewer's user_id is the email-keyed entry in the
              // members list — the cookie only carries email, but
              // members[] always includes the viewer for any circle
              // they can see.
              const viewerEmail = Astro.locals.session?.email ?? '';
              const viewerEntry = circle.members.find(
                m => m.email === viewerEmail,
              );
              const viewerId = viewerEntry?.user_id ?? circle.owner_id;
              const emailById = new Map<string, string>();
              for (const m of circle.members) emailById.set(m.user_id, m.email);
              const mine = circle.shared_habits.filter(
                sh => (sh.owner_user_id ?? viewerId) === viewerId,
              );
              const theirs = circle.shared_habits.filter(
                sh => (sh.owner_user_id ?? viewerId) !== viewerId,
              );
              return (
                <>
                  {circle.shared_habits.length === 0 && (
                    <p class="text-sm text-muted-foreground">
                      No habits shared yet. {circle.is_owner ? 'Pick one below.' : ''}
                    </p>
                  )}

                  {mine.length > 0 && (
                    <div class="space-y-1">
                      <p class="text-xs uppercase tracking-wide text-muted-foreground">
                        Yours
                      </p>
                      <ul class="divide-y divide-border" role="list">
                        {mine.map(sh => {
                          // Slice 24e: pull the habit's name out of the
                          // feed (which carries per-owner records and
                          // names). For the viewer, "Yours" rows map to
                          // feed rows owned by the viewer's email —
                          // which equals the viewer's email for the
                          // member case, and circle.owner_email for
                          // the owner case (since the owner is also a
                          // member).
                          const feedRow = feed.find(
                            f => f.habit_id === sh.habit_id
                              && f.owner_email === viewerEmail,
                          );
                          const label = feedRow?.name ?? sh.habit_id;
                          return (
                          <li class="py-2 flex items-center gap-2 text-sm">
                            <span class="font-medium">{label}</span>
                            <span class="font-mono text-xs text-muted-foreground">{sh.habit_id.slice(0, 8)}…</span>
                            <Badge variant="outline">{VISIBILITY_LABEL[sh.visibility]}</Badge>
                            {/* Slice 24e: "Yours" rows are always owned by
                                the viewer, so the trash is always
                                available. The endpoint is the member-
                                scoped DELETE (slice 24d) so the owner
                                sees it here for their own shares and a
                                member sees it for their own shares —
                                both routed through the same handler. */}
                            <form
                              method="post"
                              action={`/circles/${circleId}/members/me/habits/${sh.habit_id}/delete`}
                              class="ml-auto"
                            >
                              <Button type="submit" variant="ghost" size="icon" aria-label="Unshare this habit">
                                <Trash2 className="h-4 w-4" aria-hidden="true" />
                              </Button>
                            </form>
                           </li>
                           );
                        })}
                      </ul>
                    </div>
                  )}

                  {theirs.length > 0 && (
                    <div class={`space-y-1 ${mine.length > 0 ? 'mt-4' : ''}`}>
                      <p class="text-xs uppercase tracking-wide text-muted-foreground">
                        Members
                      </p>
                      <ul class="divide-y divide-border" role="list">
                        {theirs.map(sh => {
                          const memberEmail = sh.owner_user_id
                            ? (emailById.get(sh.owner_user_id) ?? 'a member')
                            : 'a member';
                          const feedRow = feed.find(
                            f => f.habit_id === sh.habit_id
                              && f.owner_email === memberEmail,
                          );
                          const label = feedRow?.name ?? sh.habit_id;
                          return (
                            <li class="py-2 flex items-center gap-2 text-sm">
                              <span class="font-medium">{label}</span>
                              <span class="font-mono text-xs text-muted-foreground">{sh.habit_id.slice(0, 8)}…</span>
                              <span class="text-xs text-muted-foreground">{memberEmail}</span>
                              <Badge variant="outline">{VISIBILITY_LABEL[sh.visibility]}</Badge>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}

                  {circle.is_owner && myHabits.length > 0 && (
                    <form id="share-habit-form" method="post" action={`/circles/${circleId}/share`} class="mt-4 space-y-4">
                      <div class="space-y-2">
                        <Label htmlFor="habit-id">Add a habit</Label>
                        <select
                          id="habit-id"
                          name="habit_id"
                          required
                          class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                        >
                          <option value="">Select a habit…</option>
                          {myHabits
                            .filter(h => !mine.some(sh => sh.habit_id === h.id))
                            .map(h => (
                              <option value={h.id}>{h.name}</option>
                            ))}
                        </select>
                      </div>
                      <div class="space-y-2">
                        <Label htmlFor="visibility">Visibility</Label>
                        <select
                          id="visibility"
                          name="visibility"
                          class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                        >
                          <option value="ticks">Ticks only</option>
                          <option value="ticks+streak">Ticks + streak</option>
                          <option value="ticks+streak+notes">Ticks + streak + notes</option>
                        </select>
                        <p class="text-xs text-muted-foreground">
                          {VISIBILITY_DESCRIPTION['ticks+streak+notes']}
                        </p>
                      </div>
                      <FormActions cancelHref={`/circles/${circleId}`} submitLabel="Share" formId="share-habit-form" />
                    </form>
                  )}
                </>
              );
            })()}
          </CardContent>
        </Card>

        <!-- Feed (members see this; owner too) -->
        <Card className="w-full">
          <CardHeader className="pb-2">
            <CardTitle as="h2" className="text-base font-medium">Recent activity (last 14 days)</CardTitle>
          </CardHeader>
          <CardContent className="pt-0">
            {feed.length === 0 ? (
              <p class="text-sm text-muted-foreground">
                {circle.shared_habits.length === 0
                  ? 'No habits are shared yet.'
                  : 'No ticks in the last 14 days.'}
              </p>
            ) : (
              <ul class="space-y-3" role="list">
                {feed.map(item => (
                  <li class="border border-border rounded-lg p-3">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="font-medium text-sm">{item.name}</span>
                      <span class="text-xs text-muted-foreground">({item.owner_email})</span>
                      {item.streak > 0 && (item.visibility === 'ticks+streak' || item.visibility === 'ticks+streak+notes') && (
                        <Badge variant="outline" className="ml-auto">🔥 {item.streak}-day streak</Badge>
                      )}
                    </div>
                    <div class="flex flex-wrap gap-1">
                      {item.records.map(r => (
                        <div
                          class={`h-6 w-6 rounded text-[10px] grid place-items-center ${r.done ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground'}`}
                          title={r.text ?? (r.done ? 'Done' : 'Not done')}
                          aria-label={`${r.day}: ${r.done ? 'Done' : 'Not done'}${r.text ? ` — ${r.text}` : ''}`}
                        >
                          {Number(r.day.slice(-2))}
                        </div>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </CardContent>
        </Card>

        <!-- Invites (owner only) -->
        {circle.is_owner && (
          <Card className="w-full">
            <CardHeader className="pb-2">
              <CardTitle as="h2" className="text-base font-medium">Invites</CardTitle>
            </CardHeader>
            <CardContent className="pt-0 space-y-3">
              <form id="mint-invite-form" method="post" action={`/circles/${circleId}/invites`} class="space-y-4">
                <div class="space-y-2">
                  <Label htmlFor="delivery">Delivery</Label>
                  <select
                    id="delivery"
                    name="delivery"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    <option value="link">Shareable link (token shown to you)</option>
                    <option value="email">Email (token shown to you)</option>
                  </select>
                  <p class="text-xs text-muted-foreground">
                    Either way, the invite link is shown to you above after
                    you mint it — Castor doesn't email it for you.
                  </p>
                </div>
                <div class="space-y-2">
                  <Label htmlFor="invited-email">Invitee email (optional for link)</Label>
                  <Input
                    id="invited-email"
                    name="invited_email"
                    type="email"
                    autoComplete="off"
                    placeholder="member@example.com"
                  />
                </div>
                <div class="space-y-2">
                  <Label htmlFor="ttl-hours">Expires (hours)</Label>
                  <Input
                    id="ttl-hours"
                    name="ttl_hours"
                    type="number"
                    min="1"
                    max="720"
                    value="72"
                    className="w-32"
                  />
                </div>
                <FormActions cancelHref={`/circles/${circleId}`} submitLabel="Mint invite" formId="mint-invite-form" />
              </form>

              {invites.length > 0 && (
                <ul class="divide-y divide-border" role="list">
                  {invites.map(inv => (
                    <li class="py-2 flex items-center gap-2 text-sm">
                      <Badge variant="outline">{inv.delivery}</Badge>
                      {inv.invited_email && <span class="text-xs text-muted-foreground">{inv.invited_email}</span>}
                      <span class="text-xs text-muted-foreground">
                        {inv.used_at
                          ? `used ${new Date(inv.used_at).toLocaleString('en-GB')}`
                          : `expires ${new Date(inv.expires_at).toLocaleString('en-GB')}`}
                      </span>
                      {!inv.used_at && (
                        <form method="post" action={`/circles/${circleId}/invites/${inv.id}/revoke`} class="ml-auto">
                          <Button type="submit" variant="ghost" size="icon" aria-label="Revoke invite">
                            <Trash2 className="h-4 w-4" aria-hidden="true" />
                          </Button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </CardContent>
          </Card>
        )}

        <!-- Danger zone: de-emphasised, not promoted -->
        <Card className="w-full bg-destructive/5 border-destructive/20">
          <CardContent className="pt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <p class="text-sm font-medium">
                {circle.is_owner ? 'Delete this circle' : 'Leave this circle'}
              </p>
              <p class="text-xs text-muted-foreground">
                {circle.is_owner
                  ? 'Removes the circle for everyone. Members lose access immediately.'
                  : 'You will no longer see this circle\'s shared habits.'}
              </p>
            </div>
            {circle.is_owner ? (
              <form method="post" action={`/circles/${circleId}/delete`} onsubmit="return confirm('Delete this circle for everyone? This cannot be undone.')">
                <Button type="submit" variant="ghost" size="sm" className="text-destructive hover:text-destructive">
                  <Trash2 className="h-4 w-4 mr-1" aria-hidden="true" />
                  Delete circle
                </Button>
              </form>
            ) : (
              <form method="post" action={`/circles/${circleId}/leave`} onsubmit="return confirm('Leave this circle?')">
                <Button type="submit" variant="ghost" size="sm">
                  Leave circle
                </Button>
              </form>
            )}
          </CardContent>
        </Card>
      </>
    )}
  </main>

  <script>
    // Copy-invite-URL affordance. Click "Copy link" → write the URL
    // out of the readonly input to the clipboard, swap the button
    // label briefly. No deps; falls back to selecting the input if
    // navigator.clipboard is unavailable.
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const targetId = btn.getAttribute('data-copy-target');
          if (!targetId) return;
          const input = document.getElementById(targetId) as HTMLInputElement | null;
          if (!input) return;
          const text = input.value;
          let ok = false;
          try {
            if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
              ok = true;
            } else {
              input.select();
              ok = document.execCommand('copy');
            }
          } catch {
            ok = false;
          }
          const label = btn.querySelector('[data-copy-label-text]');
          const original = btn.getAttribute('data-copy-original') ?? 'Copy link';
          if (label) {
            label.textContent = ok ? 'Copied' : 'Press ⌘C';
          }
          window.setTimeout(() => {
            if (label) label.textContent = original;
          }, 1500);
        });
      });
    });
  </script>
</Layout>
