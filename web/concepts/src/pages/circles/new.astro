---
/**
 * /circles/new — create a new circle. Server-side POST handler.
 *
 * GET: render the form.
 * POST: {name} → backend POST /api/v1/circles → redirect to /circles/{id}.
 *
 * The caller becomes the owner and is auto-added as a member so they
 * can immediately see their own shared habits.
 */
import Layout from '../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '../../components/ui/card';
import { Input } from '../../components/ui/input';
import { Label } from '../../components/ui/label';
import PageHeader from '../../components/PageHeader.astro';
import FormActions from '../../components/FormActions.astro';
import { backendFetch } from '../../lib/auth';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

let name = '';
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  name = (form.get('name') ?? '').toString().trim();

  if (name.length < 1 || name.length > 80) {
    error = 'Name must be between 1 and 80 characters.';
  } else {
    const res = await backendFetch(Astro.cookies, '/api/v1/circles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name }),
    });
    if (res.ok) {
      const created = (await res.json()) as { id: number };
      return Astro.redirect(`/circles/${created.id}`);
    }
    const detail = res.status === 401 || res.status === 403
      ? 'Not authenticated.'
      : res.status === 422
        ? 'Name is too long or empty.'
        : `Could not create circle (HTTP ${res.status}).`;
    error = detail;
  }
}
---

<Layout title="New Circle">
  <main id="main" class="castor-page">
    <PageHeader title="New Private Circle" back="/circles" />

    <Card className="w-full">
      <CardHeader>
        <CardTitle as="h2" className="text-base font-medium">Circle details</CardTitle>
      </CardHeader>
      <CardContent className="pt-0">
        <form id="castor-form" method="post" action="/circles/new" class="space-y-4">
          <div class="space-y-2">
            <Label htmlFor="name">Circle name</Label>
            <Input
              id="name"
              name="name"
              type="text"
              required
              minLength={1}
              maxLength={80}
              autoComplete="off"
              value={name}
              placeholder="e.g. Family wellness"
            />
            <p class="text-xs text-muted-foreground">
              1–80 characters. The owner (you) can rename it later.
            </p>
          </div>

          {error && (
            <p class="text-sm text-destructive">{error}</p>
          )}
        </form>
      </CardContent>
    </Card>

    <FormActions cancelHref="/circles" submitLabel="Create circle" />
  </main>
</Layout>
