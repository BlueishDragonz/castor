---
/**
 * /404 — "Page not found".
 *
 * Dogfooding the deployed app on 2026-09-27 showed that no 404 page existed,
 * so Astro served its own built-in one. That default is a dark, Astro-branded
 * page with the framework's logo, the internal request path echoed back, and
 * no navigation at all. Three problems in one screen:
 *
 *   1. It leaked the framework. The Astro wordmark is not the product.
 *   2. It inverted the theme. Every other page is light; this one was dark,
 *      so a mistyped URL looked like a different application.
 *   3. It was a dead end. No home link, no menu, nothing to click. A user
 *      who mistyped a URL or followed a stale link had to use browser
 *      back or retype the address.
 *
 * This page uses the same PublicLayout as /help, /terms and /privacy, so a
 * 404 is visually part of the product rather than a framework artifact.
 */
import Layout from '../layouts/PublicLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const { title = 'Page not found', description = 'That page does not exist.' } = Astro.props;
---

<Layout title="Not found — Castor" description="That page does not exist.">
  <main id="main" class="castor-page">
    <PageHeader
      title="Page not found"
      back="/"
      subtitle="That address does not match anything in Castor."
    />

    <div class="rounded-lg border border-border bg-card p-8 text-center">
      <p class="text-4xl font-semibold tracking-tight text-foreground/80">404</p>
      <p class="mt-3 text-sm text-muted-foreground">
        The page may have been renamed, or the link that brought you here may
        be out of date.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Go home
        </a>
        <a
          href="/help"
          class="inline-flex h-10 items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          Get help
        </a>
      </div>
    </div>
  </main>
</Layout>
