---
/**
 * /forgot-password — request a 12-digit reset code by email.
 *
 * On 2xx: render a non-destructive Alert with copy that does NOT
 * reveal whether the email exists on the backend. On 4xx: render an
 * Alert variant=destructive with the backend's detail.
 *
 * Public page — no session check, no redirect for signed-in users.
 */
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Alert, AlertDescription } from '../components/ui/alert';
import { backendFetch } from '../lib/auth';

let errorMessage: string | null = null;
let infoMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = (form.get('email') ?? '').toString().trim().toLowerCase();

  if (!email) {
    errorMessage = 'Email is required.';
  } else {
    const res = await backendFetch(Astro.cookies, '/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });

    if (res.ok) {
      // Backend always replies 200 to prevent email enumeration. Show a
      // generic confirmation — never reveal whether the email exists.
      infoMessage =
        'If that email is on file, we sent a 12-digit reset code. The code expires in 10 minutes.';
    } else if (res.status === 429) {
      errorMessage = 'Too many requests. Please wait a minute and try again.';
    } else {
      const detail = await res.json().catch(() => null);
      errorMessage =
        detail?.detail ?? `Could not send reset code (HTTP ${res.status}).`;
    }
  }
}
---

<Layout title="Forgot password — Castor">
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground"
          style="background: var(--castor-emblem-bg-primary); border-radius: var(--castor-emblem-radius);"
        >
          C
        </div>
        <div>
          <h1 class="text-xl font-semibold leading-tight">Forgot your password?</h1>
          <p class="text-xs text-muted-foreground">we'll email you a reset code</p>
        </div>
      </div>

      {errorMessage && (
        <Alert variant="destructive">
          <AlertDescription>{errorMessage}</AlertDescription>
        </Alert>
      )}

      {infoMessage && !errorMessage && (
        <Alert>
          <AlertDescription>{infoMessage}</AlertDescription>
        </Alert>
      )}

      <form method="post" class="space-y-4">
        <div class="space-y-2">
          <Label for="email">Email</Label>
          <Input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
          />
        </div>
        <Button type="submit" class="w-full">Send reset code</Button>
      </form>

      <p class="text-center text-xs text-muted-foreground">
        Remembered it?{' '}
        <a href="/login" class="hover:underline">Back to sign in</a>
      </p>
    </div>
  </main>
</Layout>
