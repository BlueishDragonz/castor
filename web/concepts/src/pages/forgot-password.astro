---
/**
 * /forgot-password — step 1 of the recovery flow. Requests a 12-digit
 * reset code to be mailed, then redirects to /verify-reset where the
 * user enters the code.
 *
 * On 4xx/429: render a destructive Alert with the backend's detail.
 * On 2xx: redirect to /verify-reset?email=... so the next page can
 * lock the email and stage the code entry. The page never reveals
 * whether the email exists on the backend.
 *
 * Brand cluster + copy is identical to the login FSM's email stage
 * (`bg-primary` solid emblem, no em-dashes, friendly second-person
 * prose). Carries through `?email=` from the login FSM so a user who
 * mistypes their password on the password stage can recover without
 * re-typing.
 *
 * Public page — no session check, no redirect for signed-in users.
 */
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Alert, AlertDescription } from '../components/ui/alert';
import { backendFetch } from '../lib/auth';

const emailQS = (Astro.url.searchParams.get('email') ?? '').trim().toLowerCase();
const throttleQS = Astro.url.searchParams.get('throttle') === '1';
const expiredQS = Astro.url.searchParams.get('expired') === '1';

let errorMessage: string | null = throttleQS
  ? 'Too many attempts just now. Please wait a minute and try again.'
  : expiredQS
    ? 'Your previous reset code expired before it could complete. Try requesting a fresh one.'
    : null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const postedEmail = (form.get('email') ?? '').toString().trim().toLowerCase();

  if (!postedEmail) {
    errorMessage = 'Please enter your email so we can send the code.';
  } else {
    // Backend mounts reset_routes under /auth (see castor/app/reset_routes.py:25).
    const res = await backendFetch(Astro.cookies, '/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: postedEmail }),
    });

    if (res.ok) {
      // Send the user directly to the verify-reset page where they can
      // enter the 12-digit code. The email travels through the URL so
      // the verify page can lock it. The verify page handles the
      // missing-email case with a friendly redirect-back hint.
      return Astro.redirect(
        `/verify-reset?email=${encodeURIComponent(postedEmail)}`
      );
    } else if (res.status === 429) {
      errorMessage = 'We have seen a lot of requests from you just now. Please wait a minute and try again.';
    } else {
      const detail = await res.json().catch(() => null);
      errorMessage =
        detail?.detail ?? `We could not send the reset code (HTTP ${res.status}). Please try again in a moment.`;
    }
  }
}

---

<Layout title="Forgot your password? — Castor">
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6">
      <div class="flex items-center gap-3">
        <div class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground bg-primary">
          C
        </div>
        <div>
          <h1 class="text-xl font-semibold leading-tight">Forgot your password?</h1>
          <p class="text-xs text-muted-foreground">we will email you a reset code</p>
        </div>
      </div>

      {errorMessage && (
        <Alert variant="destructive">
          <AlertDescription>{errorMessage}</AlertDescription>
        </Alert>
      )}

      <form method="post" class="space-y-4">
        <div class="space-y-2">
          <Label htmlFor="email">Your email</Label>
          <Input
            id="email"
            name="email"
            type="email"
            required
            autoComplete="email"
            autoFocus
            placeholder="you@example.com"
            defaultValue={emailQS}
          />
        </div>
        <Button type="submit" className="w-full">Send my reset code</Button>
      </form>

      <p class="text-center text-xs text-muted-foreground">
        Remembered it after all?{' '}
        <a href={emailQS ? `/login?stage=password_or_register&email=${encodeURIComponent(emailQS)}` : '/login'} class="hover:underline">Back to sign in</a>
      </p>
    </div>
  </main>
</Layout>
