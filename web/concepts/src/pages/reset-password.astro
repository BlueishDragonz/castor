---
/**
 * /reset-password — finish the password recovery flow.
 *
 * Reads ?email=... from the query string (the forgot-password page
 * appends it via mailto-style link). The user enters the 12-digit
 * code we emailed and a new password.
 *
 * On 2xx: redirect to /login. On 4xx: render an Alert variant=destructive
 * with the backend's detail.
 *
 * Public page — no session check.
 */
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Alert, AlertDescription } from '../components/ui/alert';
import { backendFetch } from '../lib/auth';

const email = (Astro.url.searchParams.get('email') ?? '').trim().toLowerCase();

let errorMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submittedEmail = (form.get('email') ?? '').toString().trim().toLowerCase();
  const code = (form.get('code') ?? '').toString().trim();
  const password = (form.get('password') ?? '').toString();

  if (!submittedEmail || !code || !password) {
    errorMessage = 'Email, reset code, and password are all required.';
  } else if (password.length < 12) {
    errorMessage = 'Use at least 12 characters for your password.';
  } else if (!/^\d{12}$/.test(code)) {
    errorMessage = 'The reset code must be exactly 12 digits.';
  } else {
    // Backend mounts reset_routes under /auth (see beaverhabits/app/reset_routes.py:25).
    const res = await backendFetch(Astro.cookies, '/auth/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: submittedEmail,
        code,
        new_password: password,
      }),
    });

    if (res.ok) {
      return Astro.redirect('/login');
    }

    if (res.status === 400) {
      const detail = await res.json().catch(() => null);
      errorMessage =
        detail?.detail ?? 'Invalid or expired code. Request a new one.';
    } else if (res.status === 429) {
      errorMessage = 'Too many attempts. Please wait and try again later.';
    } else {
      const detail = await res.json().catch(() => null);
      errorMessage =
        detail?.detail ?? `Could not reset password (HTTP ${res.status}).`;
    }
  }
}
---

<Layout title="Reset password — Castor">
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground"
          style="background: var(--castor-emblem-bg-primary); border-radius: var(--castor-emblem-radius);"
        >
          C
        </div>
        <div>
          <h1 class="text-xl font-semibold leading-tight">Reset your password</h1>
          <p class="text-xs text-muted-foreground">enter the code we emailed you</p>
        </div>
      </div>

      {errorMessage && (
        <Alert variant="destructive">
          <AlertDescription>{errorMessage}</AlertDescription>
        </Alert>
      )}

      <form method="post" class="space-y-4">
        <div class="space-y-2">
          <Label for="email">Email</Label>
          <Input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            defaultValue={email}
          />
        </div>
        <div class="space-y-2">
          <Label for="code">12-digit reset code</Label>
          <Input
            id="code"
            name="code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="12"
            pattern="[0-9]{12}"
            required
            placeholder="000000000000"
          />
        </div>
        <div class="space-y-2">
          <Label for="password">New password (12+ characters)</Label>
          <Input
            id="password"
            name="password"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
          />
        </div>
        <Button type="submit" class="w-full">Reset password</Button>
      </form>

      <p class="text-center text-xs text-muted-foreground">
        Didn't get a code?{' '}
        <a href="/forgot-password" class="hover:underline">Send a new one</a>
      </p>
    </div>
  </main>
</Layout>
