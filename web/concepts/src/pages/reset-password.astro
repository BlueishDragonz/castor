---
/**
 * /reset-password — legacy direct entry. Today the recovery flow is
 * staged: /forgot-password -> /verify-reset. /reset-password is kept as
 * a fallback so any old bookmarks or inbox links land at the right
 * place. The email is carried in `?email=` if present so the user does
 * not retype it.
 */
import Layout from '../layouts/PublicLayout.astro';

const emailQS = (Astro.url.searchParams.get('email') ?? '').trim().toLowerCase();
const target = emailQS
  ? `/verify-reset?email=${encodeURIComponent(emailQS)}`
  : '/forgot-password';
return Astro.redirect(target);
---

<!--
  The redirect above is server-side; this body only renders if the
  redirect itself fails (e.g. a misconfigured hosting layer that strips
  the Status header). We still emit a friendly href so the user has a
  non-JS escape hatch.
-->
<Layout title="Reset your password — Castor">
  <main id="main" class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6 text-center">
      <div class="h-12 w-12 mx-auto flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground bg-primary">
        C
      </div>
      <h1 class="text-xl font-semibold leading-tight">Reset your password</h1>
      <p class="text-sm text-muted-foreground">
        Password recovery now asks for the 12-digit code in two steps so we can confirm it works before you pick a new password.
      </p>
      <a
        href={target}
        class="inline-flex w-full items-center justify-center rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Continue to recovery
      </a>
    </div>
  </main>
</Layout>
