---
/**
 * /habits — the signed-in home view with compact habit cards matching main branch design.
 * 
 * Each habit = card row with:
 *   - Habit name (link to detail page) with context menu (Edit, Duplicate, Reorder, Archive)
 *   - 7 date columns with checkboxes
 *   - Optional streak badge (settings.INDEX_SHOW_HABIT_STREAK = false by default)
 *   - Optional total badge (settings.INDEX_SHOW_HABIT_COUNT = false by default)
 * Sticky date headers (weekday + day number)
 * Tag filter: pull-down chips at top-right, hidden by default, shown on scroll up
 * Mobile: horizontal scroll for date columns, habit name sticky left
 * 
 * Display settings are read from cookies (set via /settings page):
 * - habit_show_streak, habit_show_total, habit_show_everyday_streaks
 * - habit_name_columns, habit_date_columns, habit_date_reverse
 * - habit_enable_tag_filters, habit_tag_selection_mode
 */
import Layout from '../../layouts/Layout.astro';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '../../components/ui/card';
import HabitGrid from '../../components/HabitGrid.astro';
import PageHeader from '../../components/PageHeader.astro';
import { clearStaleSession } from '../../lib/auth';
import type { HabitPeriod } from '../../lib/period';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const { email: _sessionEmail } = Astro.locals.session;
// Email identity is now surfaced in the hamburger drawer (avatar +
// email at the top) instead of the page header. Kept on locals
// so pages that want it (e.g. /settings) can still read it.
void _sessionEmail;

// Read habit display settings from cookies (set via /settings)
const showStreak = Astro.cookies.get('habit_show_streak')?.value === 'true';
const showTotal = Astro.cookies.get('habit_show_total')?.value === 'true';
const showEveryDayStreaks = Astro.cookies.get('habit_show_everyday_streaks')?.value === 'true';
const nameColumns = parseInt(Astro.cookies.get('habit_name_columns')?.value || '5', 10);
const dateColumns = parseInt(Astro.cookies.get('habit_date_columns')?.value || '7', 10);
const dateReverse = Astro.cookies.get('habit_date_reverse')?.value === 'true';
const enableTagFilter = Astro.cookies.get('habit_enable_tag_filters')?.value !== 'false';
const tagSelectionMode = (Astro.cookies.get('habit_tag_selection_mode')?.value as 'single' | 'multi') || 'multi';

// Calendar settings
const firstDayOfWeek = parseInt(Astro.cookies.get('habit_first_day_of_week')?.value || '0', 10);
const alignTodayStr = Astro.cookies.get('habit_align_today')?.value;
const alignToday = alignTodayStr ? parseInt(alignTodayStr, 10) : null;

// Default to 7 days (today + 6 past days)
const DAYS_COUNT = dateColumns;
const today = new Date();
today.setHours(0, 0, 0, 0);

// Apply alignToday if set
let alignedToday = today;
if (alignToday !== null) {
  const daysUntilAlign = (alignToday - today.getDay() + 7) % 7;
  alignedToday = new Date(today);
  alignedToday.setDate(today.getDate() - daysUntilAlign);
  alignedToday.setHours(0, 0, 0, 0);
}

const days: Date[] = [];
for (let i = 0; i < DAYS_COUNT; i++) {
  const d = new Date(alignedToday);
  d.setDate(alignedToday.getDate() - i);
  days.push(d);
}

if (dateReverse) {
  days.reverse();
}

// Slice 10 — read ?order_by=... from URL and forward to the backend.
// Validated against the HabitOrder enum values: 'manual', 'name', 'category'.
// Invalid values are ignored (backend falls back to manual).
const rawOrderBy = Astro.url.searchParams.get('order_by');
const validOrderBy = ['manual', 'name', 'category'];
const orderBy =
  rawOrderBy && validOrderBy.includes(rawOrderBy) ? rawOrderBy : 'manual';

interface Habit {
  id: string;
  name: string;
  tags: string[];
  tickedDays: string[];
  notesByDate: Record<string, string>;
  period?: HabitPeriod | null;
  status: string;
}

let habits: Habit[] = [];
let error: string | null = null;

try {
  const token = Astro.locals.session?.token;
  if (!token) {
    error = 'Not authenticated';
  } else {
    const origin = import.meta.env.BACKEND_URL || 'http://localhost:8085';
    
    // Fetch habits list (with sort)
    const habitsQuery = orderBy === 'manual' ? '' : `?order_by=${orderBy}`;
    const habitsRes = await fetch(new URL(`/api/v1/habits${habitsQuery}`, origin), {
      headers: { 'Authorization': `Bearer ${token}` },
    });
    
    if (habitsRes.ok) {
      const habitsList = await habitsRes.json();

      // Fetch records for each habit
      const habitsWithRecords = await Promise.all(habitsList.map(async (habit: any) => {
        const recordRes = await fetch(new URL(`/api/v1/habits/${habit.id}`, origin), {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (recordRes.ok) {
          const detail = await recordRes.json();
          // Use detail for status, period, tags (list endpoint doesn't have them)
          return {
            ...habit,
            ...detail,
            records: detail.records || []
          };
        }
        return { ...habit, records: [] };
      }));

      habits = habitsWithRecords
        .filter((h: any) => h.status === 'active')
        .map((h: any) => {
          const records = h.records || [];
          const notesByDate: Record<string, string> = {};
          for (const r of records) {
            const day = r.data?.day?.split('T')[0];
            const text = (r.data?.text || '').trim();
            if (day && text) notesByDate[day] = text;
          }
          return {
            id: h.id,
            name: h.name,
            tags: h.tags || [],
            tickedDays: records
              ?.filter((r: any) => r.data?.done)
              ?.map((r: any) => r.data?.day?.split('T')[0]) || [],
            notesByDate,
            period: h.period || null,
            status: h.status,
          };
        });
    } else if (habitsRes.status === 404) {
      habits = [];
    } else if (habitsRes.status === 401 || habitsRes.status === 403) {
      // Cookie present but the backend no longer recognises it (user
      // was wiped, JWT revoked). Clear the stale session and send the
      // user to /login with a clear explanation instead of rendering
      // a permanent "HTTP 401" error card.
      clearStaleSession(Astro.cookies);
      return Astro.redirect('/login?expired=1');
    } else {
      error = `Could not load habits (HTTP ${habitsRes.status}).`;
    }
  }
} catch (e) {
  console.error('[habits page] Error:', e);
  error = (e as Error).message;
}
---
<Layout title="Habits — Castor">
  <main id="main" class="castor-page">
    <PageHeader
      title="Habits"
      subtitle={habits.length === 0 ? 'No habits yet.' : `${habits.length} active habit${habits.length === 1 ? '' : 's'}.`}
    >
      <Fragment slot="actions">
        {/*
          Reordering lives behind a single icon, not a labelled
          "Sort" dropdown. The dropdown conflated two different jobs —
          picking a sort order, and reordering rows by hand — and the
          only other sort orders (name, category) are a nicety that
          costs a full control in the most-used screen's header. The
          icon is the same LayoutGrid glyph the hamburger drawer uses
          for "Reorder habits", so the two entry points match.
        */}
        <a
          href="/habits/order"
          aria-label="Reorder habits"
          title="Reorder habits"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-background text-foreground transition-colors hover:bg-accent"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
        </a>
        <a
          href="/habits/new"
          class="inline-flex h-10 items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" class="h-4 w-4">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          New habit
        </a>
      </Fragment>
    </PageHeader>

    {error && (
      <Card className="border-destructive/50">
        <CardContent className="text-destructive py-4">{error}</CardContent>
      </Card>
    )}

    {!error && habits.length === 0 && (
      <Card>
        <CardHeader>
          <CardTitle>Start with one habit</CardTitle>
          <CardDescription>
            Pick something small enough to do on a bad day — a glass of
            water, a short walk. You can add more once this one is
            running.
          </CardDescription>
        </CardHeader>
        <CardContent>
          {/*
            The page header already carries a "New habit" primary
            button. This empty state deliberately does NOT repeat it:
            the previous version rendered "+ Add your first habit" here
            as well, giving the screen two competing primary calls to
            action for the same job.
          */}
          <p class="text-sm text-muted-foreground">
            Your habits are private to your account and stored only on
            this server.
          </p>
        </CardContent>
      </Card>
    )}
    {!error && habits.length > 0 && (
      <HabitGrid
        habits={habits}
        days={days}
        showStreak={showStreak}
        showTotal={showTotal}
        showEveryDayStreaks={showEveryDayStreaks}
        nameColumns={nameColumns}
        dateColumns={dateColumns}
        dateReverse={dateReverse}
        enableTagFilter={enableTagFilter}
        tagSelectionMode={tagSelectionMode}
        firstDayOfWeek={firstDayOfWeek}
        alignToday={alignToday}
      />
    )}
  </main>
</Layout>

