---
/**
 * /habits/[id]/edit — Edit habit page matching main branch habit_edit_dialog.
 * 
 * Fields:
 *   - Name (required)
 *   - Period: Times / Every [N] [Day/Week/Month/Year]
 *   - Completion status chips (custom or defaults)
 *   - Tags
 */
import Layout from '../../../layouts/Layout.astro';
import { Input } from '../../../components/ui/input';
import { Label } from '../../../components/ui/label';
import { Alert, AlertDescription } from '../../../components/ui/alert';
import PageHeader from '../../../components/PageHeader.astro';
import FormActions from '../../../components/FormActions.astro';
import { PERIOD_TYPE_CODE, normalisePeriod } from '../../../lib/period';
import type { HabitPeriod } from '../../../lib/period';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const token = Astro.locals.session.token;
const habitId = Astro.params.id;

interface Habit {
  id: string;
  name: string;
  tags: string[];
  period?: HabitPeriod | null;
  chips?: string[];
}

let habit: Habit | null = null;
let error: string | null = null;
let success = false;

// Handle POST request
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = (form.get('name') ?? '').toString().trim();
  const targetCount = parseInt((form.get('targetCount') ?? '1').toString(), 10);
  const periodCount = parseInt((form.get('periodCount') ?? '1').toString(), 10);
  const periodType = (form.get('periodType') ?? 'day').toString() as 'day' | 'week' | 'month' | 'year';
  const chips = (form.get('chips') ?? '').toString().trim();
  const tags = (form.get('tags') ?? '').toString().trim();

  if (!name) {
    error = 'Name is required';
  } else {
    const origin = import.meta.env.BACKEND_URL || 'http://localhost:8085';
    const res = await fetch(new URL(`/api/v1/habits/${habitId}`, origin), {
      method: 'PUT',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        name,
        /*
         * The backend's UpdateHabitPeriod model expects
         * {period_type: 'D'|'W'|'M'|'Y', period_count, target_count}.
         * The form used to send {frequency, interval, period_count},
         * which the backend's pydantic model rejected — the extra keys
         * were dropped and the required ones were missing, so the
         * period could never be saved. `target_count` is how many times
         * per period the habit should be done ("Times" in the form) and
         * `period_count` is the length of the period ("Every N").
         */
        period: {
          period_type: PERIOD_TYPE_CODE[periodType] ?? 'D',
          period_count: periodCount,
          target_count: targetCount,
        },
        tags: tags ? tags.split(',').map(t => t.trim()).filter(Boolean) : [],
      }),
    });

    if (res.ok) {
      success = true;
      // Re-fetch habit
      const habitRes = await fetch(new URL(`/api/v1/habits/${habitId}`, origin), {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (habitRes.ok) {
        habit = await habitRes.json();
      }
    } else {
      const err = await res.json().catch(() => ({ detail: 'Failed to update habit' }));
      error = err.detail || `Failed to update habit (HTTP ${res.status})`;
    }
  }
}

if (!success) {
  try {
    const origin = import.meta.env.BACKEND_URL || 'http://localhost:8085';
    const res = await fetch(new URL(`/api/v1/habits/${habitId}`, origin), {
      headers: { 'Authorization': `Bearer ${token}` },
    });
    
    if (res.ok) {
      habit = await res.json();
    } else if (res.status === 404) {
      error = 'Habit not found';
    } else {
      error = `Could not load habit (HTTP ${res.status})`;
    }
  } catch (e) {
    error = (e as Error).message;
  }
}

// Default chips from settings
const DEFAULT_CHIPS = ['yes', 'no'];

const PERIOD_TYPES = ['day', 'week', 'month', 'year'] as const;
const PERIOD_LABELS: Record<string, string> = {
  day: 'Day',
  week: 'Week',
  month: 'Month',
  year: 'Year',
};

/*
 * The form's "Times / Every N / Interval" inputs are seeded from the
 * habit's stored period. Reading `habit.period.interval` directly
 * (as this page used to) always yielded undefined because the backend
 * sends period_type/target_count/period_count — so the form silently
 * showed 1/1/Day for every habit regardless of its real schedule.
 */
const period = habit ? normalisePeriod(habit.period) : null;

---
<Layout title="Edit habit — Castor">
  <main id="main" class="castor-page castor-page--narrow">
    <PageHeader
      title="Edit habit"
      subtitle={habit ? habit.name : undefined}
      back={`/habits/${habitId}`}
    />

    {error && (
      <Alert variant="destructive">
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}

    {success && (
      <Alert>
        <AlertDescription>
          Habit updated. <a href={`/habits/${habitId}`} class="font-medium underline">Back to {habit?.name}</a>
        </AlertDescription>
      </Alert>
    )}

    {habit && !error && !success && (
      <form method="post" action={`/habits/${habitId}/edit`} id="castor-form" class="castor-stack">
        <input type="hidden" name="habitId" value={habitId} />

        <div class="space-y-2">
          <Label htmlFor="name">Name</Label>
          <Input
            id="name"
            name="name"
            value={habit.name}
            required
            maxLength={100}
            placeholder="Habit name"
            aria-describedby="name-hint"
          />
          <p id="name-hint" class="text-xs text-muted-foreground">
            What you want to see each morning.
          </p>
        </div>

        <fieldset class="space-y-3 border-t pt-5">
          <legend class="text-sm font-semibold">How often</legend>
          <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-3">
            <div class="space-y-1.5">
              <Label htmlFor="targetCount">Times</Label>
              <Input
                id="targetCount"
                name="targetCount"
                type="number"
                value={period?.targetCount ?? 1}
                min={1}
                max={366}
                required
                className="w-full"
              />
            </div>
            <span class="pb-3 text-muted-foreground" aria-hidden="true">/</span>
            <div class="space-y-1.5">
              <Label htmlFor="periodCount">Every</Label>
              <Input
                id="periodCount"
                name="periodCount"
                type="number"
                value={period?.periodCount ?? 1}
                min={1}
                max={366}
                required
                className="w-full"
              />
            </div>
          </div>
          <div class="space-y-1.5">
            <Label htmlFor="periodType">Interval</Label>
            <select
              id="periodType"
              name="periodType"
              class="flex h-10 w-full items-center rounded-md border border-input bg-background px-3 py-2 text-sm"
              aria-describedby="period-hint"
            >
              {PERIOD_TYPES.map(type => (
                <option value={type} selected={(period?.interval ?? 'day') === type}>
                  {PERIOD_LABELS[type]}
                </option>
              ))}
            </select>
          </div>
          <p id="period-hint" class="text-xs text-muted-foreground">
            1 time every 1 day means daily. 3 times every 1 week means three
            times a week.
          </p>
        </fieldset>

        <div class="space-y-2 border-t pt-5">
          <Label htmlFor="tags">Tags</Label>
          <Input
            id="tags"
            name="tags"
            value={habit.tags.join(', ')}
            placeholder="health, fitness"
            aria-describedby="tags-hint"
          />
          <p id="tags-hint" class="text-xs text-muted-foreground">
            Comma-separated. Used to filter the grid on your habits page.
          </p>
        </div>

        <FormActions cancelHref={`/habits/${habitId}`} submitLabel="Save changes" />
      </form>
    )}
  </main>
</Layout>