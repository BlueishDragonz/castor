---
/**
 * /habits/new — add a new habit with full form matching main branch habit_edit_dialog.
 * 
 * Fields:
 * - Name (with inline tags using #tag syntax)
 * - Period (Times / Every N / Interval: Day/Week/Month/Year)
 * - Completion Status (chips like "yes, no" or custom)
 * - Tags (comma-separated)
 * 
 * POSTs JSON to /api/v1/habits and redirects to /habits on success.
 */
import Layout from '../../layouts/Layout.astro';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Label } from '../../components/ui/label';
import { Alert, AlertDescription } from '../../components/ui/alert';
import PageHeader from '../../components/PageHeader.astro';
import FormActions from '../../components/FormActions.astro';
import { backendFetch } from '../../lib/auth';
import { PERIOD_TYPE_CODE } from '../../lib/period';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

let errorMessage: string | null = null;
let formData = {
  name: '',
  targetCount: '1',
  periodCount: '1',
  periodType: 'day',
  chips: 'yes, no',
  tags: '',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  
  formData = {
    name: (form.get('name') ?? '').toString().trim(),
    targetCount: (form.get('targetCount') ?? '1').toString(),
    periodCount: (form.get('periodCount') ?? '1').toString(),
    periodType: (form.get('periodType') ?? 'day').toString(),
    chips: (form.get('chips') ?? 'yes, no').toString(),
    tags: (form.get('tags') ?? '').toString().trim(),
  };

  const name = formData.name;
  
  if (!name) {
    errorMessage = 'Give your habit a name.';
  } else if (!formData.targetCount.match(/^\d+$/) || parseInt(formData.targetCount) <= 0) {
    errorMessage = 'Invalid target count.';
  } else if (!formData.periodCount.match(/^\d+$/) || parseInt(formData.periodCount) <= 0) {
    errorMessage = 'Invalid period count.';
  } else {
    const targetCount = parseInt(formData.targetCount);
    const periodCount = parseInt(formData.periodCount);
    
    // Validate period against max values
    const maxTimes: Record<string, number> = { day: 1, week: 7, month: 31, year: 366 };
    if (targetCount > (maxTimes[formData.periodType] || 1) * periodCount) {
      errorMessage = 'Target count exceeds maximum for the selected period.';
    } else {
      const period = {
        /*
         * The backend's HabitFrequency.from_dict reads exactly these
         * three keys and raises KeyError on anything else. This form
         * previously sent {frequency, interval, periodCount} — a third
         * spelling of the same idea, which no endpoint accepts, so
         * creating a habit with a period other than the default either
         * failed or silently stored nothing.
         */
        period_type: PERIOD_TYPE_CODE[
          formData.periodType as keyof typeof PERIOD_TYPE_CODE
        ] ?? 'D',
        period_count: periodCount,
        target_count: targetCount,
      };

      const habitData = {
        name: name.split('#')[0].trim(), // Extract name without tags
        period,
        tags: name.split('#').slice(1).map(t => t.trim()).filter(Boolean).concat(
          formData.tags.split(',').map(t => t.trim()).filter(Boolean)
        ),
        chips: formData.chips.split(',').map(c => c.trim()).filter(Boolean),
      };

      const res = await backendFetch(Astro.cookies, '/api/v1/habits', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(habitData),
      });

      if (res.ok) {
        return Astro.redirect('/habits');
      }
      if (res.status === 400 || res.status === 422) {
        const detail = await res.json().catch(() => null);
        errorMessage = detail?.detail ?? 'That name was not accepted.';
      } else {
        errorMessage = `Could not create habit (HTTP ${res.status}).`;
      }
    }
  }
}
---
<Layout title="Add habit — Castor">
  <main id="main" class="castor-page castor-page--narrow">
    <PageHeader
      title="Add a habit"
      subtitle="one small thing, repeated daily."
      back="/habits"
    />

    {errorMessage && (
      <Alert variant="destructive">
        <AlertDescription>{errorMessage}</AlertDescription>
      </Alert>
    )}

    <form id="castor-form" method="post" class="space-y-6">
      <div class="space-y-2">
        <Label htmlFor="name">Habit name</Label>
        <Input
          id="name"
          name="name"
          required
          maxLength={60}
          placeholder="e.g. Drink water #health #daily"
          value={formData.name}
        />
        <p class="text-xs text-muted-foreground">
          Add tags inline with <code>#tag</code> syntax (e.g. "Exercise #fitness #health")
        </p>
      </div>

      <fieldset class="space-y-4 border-t pt-4">
        <legend class="text-sm font-medium">How often</legend>
        {/*
          Phrased as a sentence the user can read rather than as three
          stacked fields. The previous layout put "Times", a literal
          "/ Every" separator, and "Every" into a 3-column grid, which
          read as "1 / Every Every" in the accessibility tree and left
          the separator with no control attached to it.
        */}
        <div class="period-row">
          <div class="period-field">
            <Label htmlFor="targetCount">Times</Label>
            <Input
              id="targetCount"
              name="targetCount"
              type="number"
              min="1"
              max="366"
              value={formData.targetCount}
              aria-describedby="period-example"
              className="w-full"
            />
          </div>
          <span class="period-joiner" aria-hidden="true">per</span>
          <div class="period-field period-field--narrow">
            <Label htmlFor="periodCount">Every</Label>
            <Input
              id="periodCount"
              name="periodCount"
              type="number"
              min="1"
              max="366"
              value={formData.periodCount}
              aria-describedby="period-example"
              className="w-full"
            />
          </div>
          <div class="period-field">
            <Label htmlFor="periodType">Interval</Label>
            <select
              id="periodType"
              name="periodType"
              aria-describedby="period-example"
              class="period-select"
            >
              <option value="day" selected={formData.periodType === 'day'}>Day</option>
              <option value="week" selected={formData.periodType === 'week'}>Week</option>
              <option value="month" selected={formData.periodType === 'month'}>Month</option>
              <option value="year" selected={formData.periodType === 'year'}>Year</option>
            </select>
          </div>
        </div>

        <p id="period-example" class="text-xs text-muted-foreground">
          Example: 1 time per 1 day is a daily habit. 3 times per 1 week is
          3× per week.
        </p>
      </fieldset>

      <div class="space-y-2 border-t pt-4">
        <Label htmlFor="chips">Completion Status</Label>
        <Input
          id="chips"
          name="chips"
          value={formData.chips}
          placeholder="yes, no"
          className="w-full"
        />
        <p class="text-xs text-muted-foreground">
          Comma-separated values. Use "yes"/"no" for defaults or custom like "done:✓,skip:⊘"
        </p>
      </div>

      <div class="space-y-2">
        <Label htmlFor="tags">Additional Tags</Label>
        <Input
          id="tags"
          name="tags"
          value={formData.tags}
          placeholder="health, fitness, morning"
          className="w-full"
        />
        <p class="text-xs text-muted-foreground">Comma-separated tags for filtering (also supports #tag in name field).</p>
      </div>

      <FormActions cancelHref="/habits" submitLabel="Create" />
    </form>
  </main>
</Layout>