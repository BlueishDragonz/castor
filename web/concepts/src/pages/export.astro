---
/**
 * /export — download a JSON snapshot of all the signed-in user's habits.
 *
 * The backend exposes GET /api/v1/habits/export which returns the
 * full habit_list dict (habits + order + meta). The Astro page acts
 * as a thin proxy:
 *
 *   1. Auth gate: redirect to /login if no session.
 *   2. Server-side GET to the backend with the bearer attached via
 *      backendFetch (the cookie carries the bearer; backendFetch
 *      reads it and re-attaches as Authorization).
 *   3. On 200: stream the body back with Content-Disposition set to
 *      `attachment; filename=castor-export-YYYY-MM-DD.json` so the
 *      browser saves it instead of trying to render it.
 *   4. On error: render an Alert explaining the failure.
 *
 * Why server-side and not client-side fetch:
 *   - The castor_token is httpOnly; client JS can't read it. A
 *     client-side export would need a parallel JS-readable bearer
 *     (regression).
 *   - Content-Disposition is a server concern; setting it from JS
 *     means building a Blob URL and forcing a download, which works
 *     but adds two round-trips and a memory copy of the export.
 */
import Layout from '../layouts/Layout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '../components/ui/card';
import { Alert, AlertDescription, AlertTitle } from '../components/ui/alert';
import { Button } from '../components/ui/button';
import PageHeader from '../components/PageHeader.astro';
import { Download } from 'lucide-react';
import { backendFetch } from '../lib/auth';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

// Local-date filename. toISOString() is UTC, which names the file after
// yesterday for anyone east of Greenwich in the evening.
const now = new Date();
const filename = `castor-export-${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}.json`;

let errorDetail: string | null = null;

if (Astro.request.method === 'POST') {
  const res = await backendFetch(Astro.cookies, '/api/v1/habits/export', {
    method: 'GET',
  });

  if (res.ok) {
    const body = await res.text();
    return new Response(body, {
      status: 200,
      headers: {
        'Content-Type': 'application/json; charset=utf-8',
        'Content-Disposition': `attachment; filename="${filename}"`,
        'Cache-Control': 'no-store',
      },
    });
  }

  // Surface the backend's detail if it sent one, otherwise a generic
  // message keyed off the status code.
  if (res.status === 401 || res.status === 403) {
    errorDetail = 'Your session has expired. Sign in again and retry.';
  } else {
    try {
      const data = (await res.json()) as { detail?: string } | null;
      errorDetail = data?.detail ?? null;
    } catch {
      // body wasn't JSON
    }
    if (!errorDetail) errorDetail = `Export failed (HTTP ${res.status}).`;
  }
}
---

<Layout title="Export — Castor">
  <main id="main" class="castor-page">
    <PageHeader
      title="Export"
      subtitle="Download every habit with its full tick history as a JSON file."
      back="/habits"
    />

    {errorDetail && (
      <Alert variant="destructive">
        <AlertTitle>Export failed</AlertTitle>
        <AlertDescription>{errorDetail}</AlertDescription>
      </Alert>
    )}

    <div class="castor-stack">
      <Card>
        <CardHeader>
          <CardTitle as="h2">Download your data</CardTitle>
          <CardDescription>
            One JSON file containing every habit with its tags, frequency,
            status and tick history, plus the order they appear in on your home
            page. Feed it straight back to <a href="/import" class="underline underline-offset-2">Import</a>
            to restore.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <form method="post">
            <Button
              type="submit"
              size="wrap"
              className="w-full gap-2 sm:w-auto sm:justify-center"
            >
              <Download className="h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="min-w-0">Download {filename}</span>
            </Button>
          </form>
          <p class="text-xs text-muted-foreground">
            The file is generated on demand and never stored. It contains your
            habit names and history in plain text, so keep it somewhere
            private.
          </p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle as="h2">What the file contains</CardTitle>
          <CardDescription>
            A single JSON object, so an export stays readable even as the
            format grows.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="font-medium">Habits</dt>
              <dd class="text-muted-foreground">Name, tags, frequency, status</dd>
            </div>
            <div>
              <dt class="font-medium">Records</dt>
              <dd class="text-muted-foreground">
                Every ticked day, with its note and timestamp
              </dd>
            </div>
            <div>
              <dt class="font-medium">Order</dt>
              <dd class="text-muted-foreground">
                Your home page order, so a restore looks unchanged
              </dd>
            </div>
            <div>
              <dt class="font-medium">Format</dt>
              <dd class="text-muted-foreground">
                <code>application/json</code>, UTF-8
              </dd>
            </div>
          </dl>
        </CardContent>
      </Card>
    </div>
  </main>
</Layout>
