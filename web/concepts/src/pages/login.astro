---
/**
 * /login — form posts to backend /auth/login (form-encoded).
 *
 * On 200: store the bearer in an httpOnly cookie via Astro.server
 * cookie API + redirect to /habits. On 4xx: render an Alert with the
 * backend's error detail.
 *
 * Already signed-in users get bounced to /habits on visit.
 *
 * WebAuthn/Passkey: progressive disclosure.
 *   - Email field is always visible.
 *   - The credential check happens on the client when the email is
 *     well-formed; we POST /api/auth/webauthn/check for the result.
 *   - If the email has a registered passkey → show the "Sign in with
 *     passkey" button. Hide the password field.
 *   - Otherwise → show the password field. Hide the passkey button.
 *   - "Unknown user" is INDISTINGUISHABLE from "no passkey" by design
 *     — both show the password path (which falls back to a 401).
 *   - On /habits the user is offered to enroll a passkey via the
 *     Security page, never re-asked in the login flow itself.
 */
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Alert, AlertDescription } from '../components/ui/alert';
import { backendFetch, writeSession } from '../lib/auth';

// Already signed in? Skip the form.
if (Astro.locals.session) {
  return Astro.redirect('/habits');
}

let errorMessage: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const username = (form.get('username') ?? '').toString();
  const password = (form.get('password') ?? '').toString();

  if (!username || !password) {
    errorMessage = 'Email and password are required.';
  } else {
    // fastapi-users default BearerTransport expects form-encoded body.
    const body = new URLSearchParams({ username, password });
    const res = await backendFetch(Astro.cookies, '/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString(),
    });

    if (res.ok) {
      const data = (await res.json()) as { access_token: string; token_type: string };
      writeSession(Astro.cookies, data.access_token, username);
      return Astro.redirect('/habits');
    }

    if (res.status === 400 || res.status === 401) {
      errorMessage = 'That email and password do not match an account.';
    } else {
      errorMessage = `Sign-in failed (HTTP ${res.status}). Try again.`;
    }
  }
}
---
<Layout title="Sign in — Castor">
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-sm space-y-6">
      <div class="flex items-center gap-3">
        <div
          class="h-12 w-12 flex items-center justify-center rounded-2xl text-lg font-semibold text-primary-foreground"
          style="background: var(--castor-emblem-bg-primary); border-radius: var(--castor-emblem-radius);"
        >
          C
        </div>
        <div>
          <h1 class="text-xl font-semibold leading-tight">Sign in to Castor</h1>
          <p class="text-xs text-muted-foreground">privacy-first habit tracker</p>
        </div>
      </div>

      {errorMessage && (
        <Alert variant="destructive">
          <AlertDescription>{errorMessage}</AlertDescription>
        </Alert>
      )}

      <form method="post" class="space-y-4" id="login-form">
        <div class="space-y-2">
          <Label htmlFor="username">Email</Label>
          <Input
            id="username"
            name="username"
            type="email"
            required
            autoComplete="email"
            placeholder="you@example.com"
          />
          <p
            id="email-status"
            class="text-xs text-muted-foreground min-h-4"
            aria-live="polite"
          >
          </p>
        </div>

        <div id="password-row" class="space-y-2">
          <Label htmlFor="password">Password</Label>
          <Input
            id="password"
            name="password"
            type="password"
            autoComplete="current-password"
          />
        </div>

        <Button type="submit" id="signin-button" className="w-full">
          Sign in
        </Button>
      </form>

      <div id="passkey-row" class="hidden space-y-3">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <span class="w-full border-t" />
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="bg-background px-2 text-muted-foreground">Or continue with</span>
          </div>
        </div>
        <button
          type="button"
          id="webauthn-login-btn"
          class="flex w-full items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2.5 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 1.89l5.46 2.43c2.36.99 4 3.76 4 6.78 0 4.42-3.58 8-8 8s-8-3.58-8-8c0-3.02 1.64-5.79 4-6.78L12 2.89zM12 6c-2.33 0-4.31 1.16-5.5 2.88 1.12 1.44 2.4 3.37 2.5 5.23h5.91c.09-1.86 1.38-3.79 2.5-5.23C16.31 7.16 14.33 6 12 6z" />
          </svg>
          Sign in with Passkey
        </button>
      </div>

      <p class="text-center text-xs text-muted-foreground">
        <a href="/forgot-password" class="hover:underline">Forgot password?</a>
        <span class="mx-2 opacity-50">·</span>
        <a href="/register" class="hover:underline">Create account</a>
      </p>
    </div>
  </main>

  <script>
    let inflight: AbortController | null = null;

    async function probe(email: string) {
      const status = document.getElementById('email-status');
      if (!status) return;

      if (inflight) inflight.abort();
      const ctrl = new AbortController();
      inflight = ctrl;

      try {
        const res = await fetch('/api/auth/webauthn/check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: email }),
          signal: ctrl.signal,
        });
        if (ctrl.signal.aborted) return;
        if (!res.ok) {
          hideBoth(status);
          return;
        }
        const data = (await res.json()) as { has_passkey?: boolean };
        const passkeyRow = document.getElementById('passkey-row');
        const passwordRow = document.getElementById('password-row');
        if (data.has_passkey) {
          if (passkeyRow) passkeyRow.classList.remove('hidden');
          if (passwordRow) {
            passwordRow.classList.add('hidden');
            const pwInput = document.getElementById('password') as HTMLInputElement | null;
            if (pwInput) pwInput.value = '';
          }
          status.textContent = 'Passkey detected for this account.';
        } else {
          if (passkeyRow) passkeyRow.classList.add('hidden');
          if (passwordRow) passwordRow.classList.remove('hidden');
          status.textContent = '';
        }
      } catch (e) {
        if ((e as DOMException).name === 'AbortError') return;
        hideBoth(status);
      }
    }

    function hideBoth(status: HTMLElement) {
      const passkeyRow = document.getElementById('passkey-row');
      const passwordRow = document.getElementById('password-row');
      if (passkeyRow) passkeyRow.classList.add('hidden');
      if (passwordRow) passwordRow.classList.remove('hidden');
      status.textContent = '';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const emailInput = document.getElementById('username') as HTMLInputElement | null;
      if (!emailInput) return;

      const resetToPasswordOnly = () => {
        const status = document.getElementById('email-status');
        if (status) status.textContent = '';
        const passkeyRow = document.getElementById('passkey-row');
        const passwordRow = document.getElementById('password-row');
        if (passkeyRow) passkeyRow.classList.add('hidden');
        if (passwordRow) passwordRow.classList.remove('hidden');
      };

      const onChange = () => {
        const email = emailInput.value.trim();
        const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!valid) {
          resetToPasswordOnly();
          return;
        }
        void probe(email);
      };

      let timer: number | null = null;
      emailInput.addEventListener('input', () => {
        if (timer !== null) window.clearTimeout(timer);
        timer = window.setTimeout(onChange, 250);
      });
      if (emailInput.value) onChange();

      const btn = document.getElementById('webauthn-login-btn') as HTMLButtonElement | null;
      btn?.addEventListener('click', async () => {
        const email = emailInput.value?.trim();
        if (!email) {
          emailInput.focus();
          return;
        }

        const submit = document.getElementById('signin-button') as HTMLButtonElement | null;
        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Awaiting passkey…';
        }

        try {
          const response = await fetch('/auth/webauthn/login/begin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: email }),
          });
          if (!response.ok) {
            const error = await response.json().catch(() => ({ detail: 'Unknown error' }));
            throw new Error(error.detail || 'Failed to start passkey login');
          }
          const options = await response.json();
          const publicKey = options.publicKey;
          publicKey.challenge = base64urlToBuffer(publicKey.challenge);
          publicKey.allowCredentials = publicKey.allowCredentials?.map((c: any) => ({
            ...c,
            id: base64urlToBuffer(c.id),
          }));
          const credential = await navigator.credentials.get({ publicKey });
          if (!credential) throw new Error('No credential returned');
          if (!(credential instanceof PublicKeyCredential)) throw new Error('Not a public-key credential');
          if (!(credential.response instanceof AuthenticatorAssertionResponse)) throw new Error('Unexpected credential response type');
          const pkCredential = credential;
          const assertion = credential.response;

          const authResponse = await fetch('/api/auth/webauthn/login/complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: pkCredential.id,
              rawId: bufferToBase64url(pkCredential.rawId),
              response: {
                clientDataJSON: bufferToBase64url(assertion.clientDataJSON),
                authenticatorData: bufferToBase64url(assertion.authenticatorData),
                signature: bufferToBase64url(assertion.signature),
                userHandle: assertion.userHandle
                  ? bufferToBase64url(assertion.userHandle)
                  : undefined,
              },
              type: pkCredential.type,
              username: email,
            }),
          });
          if (!authResponse.ok) {
            const error = await authResponse.json().catch(() => ({ detail: 'Authentication failed' }));
            throw new Error(error.detail || 'Passkey login failed');
          }

          window.location.href = '/habits';
        } catch (err) {
          console.error('WebAuthn login error:', err);
          if (submit) {
            submit.disabled = false;
            submit.textContent = 'Sign in';
          }
          const status = document.getElementById('email-status');
          if (status) status.textContent = `Passkey login failed: ${(err as Error).message}`;
        }
      });
    });

    function base64urlToBuffer(str: string): ArrayBuffer {
      const base64 = str.replace(/-/g, '+').replace(/_/g, '/');
      const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, '=');
      const binary = atob(padded);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      return bytes.buffer;
    }

    function bufferToBase64url(buf: ArrayBuffer): string {
      const bytes = new Uint8Array(buf);
      let binary = '';
      for (let i = 0; i < bytes.length; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      return btoa(binary)
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=/g, '');
    }
  </script>
</Layout>
