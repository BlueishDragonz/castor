---
/**
 * /settings — the signed-in user's preferences and account controls.
 *
 * Sections:
 *   1. Account identity (email) — read from Astro.locals.session.
 *   2. Theme — Light/Dark toggle. Submitting the form sets the
 *      `castor-theme` cookie (max-age 1 year, sameSite lax, path /)
 *      and redirects back here so Layout.astro re-renders with the
 *      new `data-theme` attribute. No client JS — the redirect gives
 *      us the re-render we need.
 *   3. Custom CSS — textarea bound to SettingsClient which PUTs to
 *      /api/v1/user-configs (custom_css key). The legacy castor main
 *      applied CSS via the backend's tinycss2 sanitiser (see
 *      castor/css_sanitizer.py); the Astro side sends raw text and
 *      relies on the backend to reject anything unsafe. Custom CSS is
 *      non-portable across browsers; v1 keeps it as a textarea rather
 *      than a CodeMirror island.
 *   4. Display — three boolean toggles (show_streak, show_total,
 *      date_reverse). SettingsClient PUTs each one immediately to
 *      /api/v1/user-configs. The /habits grid reads these server-side
 *      when rendering, so a session/device change preserves the
 *      choice. (parity row 12.6)
 *   5. Help — opens a shadcn Dialog with the same four links as the
 *      legacy layout.py::show_help_dialog (Wiki / Supporter / YouTube
 *      / Issues).
 *   6. Account actions — Sign out (POST /logout) and a destructive
 *      link to /account/delete.
 *
 * Numeric / enum display keys (date_columns, first_day_of_week, tag
 * filters) are not yet wired. The backend's PUT body accepts the three
 * booleans + custom_css only; expanding would require new Strict* type
 * fields. Deferred to a later slice.
 */
import Layout from '../layouts/Layout.astro';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Alert, AlertDescription } from '../components/ui/alert';
import { Separator } from '../components/ui/separator';
import HelpDialog from '../components/HelpDialog.tsx';
import SettingsClient from '../components/SettingsClient.tsx';
import DisplayCard from '../components/DisplayCard.tsx';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const {} = Astro.locals.session;

// Read the current theme so the radio reflects what's already in effect.
const currentTheme =
  Astro.cookies.get('castor-theme')?.value === 'dark' ? 'dark' : 'light';

// Theme POST handler. Validate the value, set the cookie, then redirect
// back to /settings so Layout.astro re-renders with the new data-theme.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = (form.get('_action') ?? '').toString();

  if (action === 'theme') {
    const next = (form.get('theme') ?? '').toString();
    if (next === 'light' || next === 'dark') {
      Astro.cookies.set('castor-theme', next, {
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 365,
      });
      return Astro.redirect('/settings');
    }
  }
}
---

<Layout title="Settings — Castor">
  <main class="mx-auto max-w-2xl px-6 py-12 space-y-8 pb-24">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
      <a
        href="/habits"
        class="hidden sm:inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        &larr; Back to habits
      </a>
    </header>

    <Card>
      <CardHeader>
        <CardTitle>Appearance</CardTitle>
        <CardDescription>Choose how Castor looks. Saved per device.</CardDescription>
      </CardHeader>
      <CardContent>
        <form method="post" class="space-y-4">
          <input type="hidden" name="_action" value="theme" />
          <fieldset class="space-y-2">
            <legend class="text-sm font-medium">Theme</legend>

            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="theme"
                value="light"
                checked={currentTheme === 'light'}
                class="h-4 w-4 accent-primary"
              />
              <span class="text-sm">Light</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="theme"
                value="dark"
                checked={currentTheme === 'dark'}
                class="h-4 w-4 accent-primary"
              />
              <span class="text-sm">Dark</span>
            </label>
          </fieldset>

          <Button type="submit" size="sm">Save theme</Button>
        </form>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>Custom CSS</CardTitle>
        <CardDescription>
          Advanced: write custom CSS to customize Castor's appearance.
          Saved on Save; sanitized server-side before applying.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <textarea
          id="custom-css"
          name="custom-css"
          class="min-h-[200px] font-mono text-xs w-full px-3 py-2 border border-border rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-ring"
          placeholder="/* Your custom CSS here */"
          spellcheck="false"
        ></textarea>
        <div class="flex items-center justify-between mt-3 gap-3">
          <p class="text-xs text-muted-foreground">
            Click Save to persist. Rejected CSS is left untouched so you
            can fix and retry. Server-stored CSS survives browser /
            device changes.
          </p>
          <Button id="custom-css-save" type="button" size="sm">
            Save CSS
          </Button>
        </div>
      </CardContent>
    </Card>

    <!-- Display card moved to <DisplayCard /> React island (slice 16):
         uses the shadcn Checkbox primitive for visual parity with the
         radios + buttons on the same page. Behaviour (cookie mirror +
         immediate PUT to /api/v1/user-configs) is preserved. -->
    <DisplayCard client:load />

    <Card>
      <CardHeader>
        <CardTitle>Help</CardTitle>
        <CardDescription>
          Resources and places to ask questions or report bugs.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <HelpDialog client:load />
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>Account</CardTitle>
        <CardDescription>Manage your session and account.</CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        <form method="post" action="/logout">
          <Button type="submit" variant="outline">Sign out</Button>
        </form>

        <Separator />

        <Alert variant="destructive">
          <AlertDescription>
            Deleting your account is permanent — all your habits and
            history are erased.
          </AlertDescription>
        </Alert>
        <Button asChild variant="destructive">
          <a href="/account/delete">Delete account</a>
        </Button>
      </CardContent>
    </Card>
  </main>
  <SettingsClient client:load />
</Layout>
