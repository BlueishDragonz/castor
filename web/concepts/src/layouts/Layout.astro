---
/**
 * Castor Layout — global page shell.
 *
 * Loads the design tokens, applies the active theme, and provides a slot
 * for page content. Server-rendered, no client JS unless the page opts in.
 *
 * The `data-theme` attribute toggles between light/dark by reading a
 * cookie set on first visit. Future: hook into a theme-switch component.
 */
import '../styles/tokens.css';
import BottomNav from '../components/BottomNav.astro';
import { DesktopMenu } from '../components/DesktopMenu.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Castor',
  description = 'A privacy-first habit tracker you can self-host.',
} = Astro.props;

// Theme defaults to "light" until /api/account/me reports otherwise.
const theme = Astro.cookies.get('castor-theme')?.value ?? 'light';

// Umami analytics — ported from beaverhabits/frontend/layout.py:48-51.
// Conditional: when PUBLIC_UMAMI_ANALYTICS_ID is set, inject the
// tracker script. PUBLIC_UMAMI_SCRIPT_URL overrides the default
// cloud.umami.is host so self-hosters can point at their own.
const umamiId = import.meta.env.PUBLIC_UMAMI_ANALYTICS_ID ?? '';
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL
  ?? 'https://cloud.umami.is/script.js';
const umamiEnabled = !!umamiId;
---

<!doctype html><html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- PWA — ported from beaverhabits/frontend/layout.py::pwa_headers. -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Castor" />
    <meta name="application-name" content="Castor" />
    <meta name="theme-color" content="#f9f9f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {umamiEnabled && (
      <script
        defer
        src={umamiScript}
        data-website-id={umamiId}
      ></script>
    )}

    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased"><slot />{Astro.locals.session && (<>
        <BottomNav />
        <DesktopMenu client:load />
      </>)}</body>
</html>