---
/**
 * HabitCheckBox — a single grid cell that toggles completion for a habit on a given day.
 *
 * Submits a real <form action="/habits/{id}/complete" method="post">
 * with {date, done}. The server-side route forwards to
 * POST /api/v1/habits/{id}/completions using the httpOnly cookie.
 *
 * No bearer ever reaches the client. This removes the
 * window.toggleDone global and the `token` prop that were the
 * same XSS exposure pattern as the WebAuthn, import, and
 * habit-detail pages.
 *
 * Accessibility: each cell is a `<button role="switch">` so screen
 * readers announce the state and Enter/Space toggles it.
 *
 * Date encoding:
 *   - `dateStr` (DD-MM-YYYY, backend tick format) uses local-time
 *     getters via toLocaleDateString — always correct.
 *   - `data-tick-date` (YYYY-MM-DD, used by HabitNoteRow for note
 *     keys) MUST avoid `toISOString().split('T')[0]` because that
 *     returns UTC and drifts by the timezone offset. We derive it
 *     from local-time components via localISO().
 */
interface Props {
  habitId: string;
  habitName: string;
  date: Date;
  done: boolean;
  isToday: boolean;
  isPast: boolean;
}

const { habitId, habitName, date, done, isToday, isPast } = Astro.props;

const dateStr = date.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }).replace(/\//g, '-');
const y = date.getFullYear();
const m = String(date.getMonth() + 1).padStart(2, '0');
const d = String(date.getDate()).padStart(2, '0');
const isoDate = `${y}-${m}-${d}`; // local YYYY-MM-DD
const daysAgo = Math.floor(
  (new Date().getTime() - date.getTime()) / (1000 * 60 * 60 * 24),
);
const daysAgoLabel = daysAgo === 1 ? '1 day ago' : `${daysAgo} days ago`;
const ariaLabel = isToday
  ? `Today, ${habitName}`
  : isPast
    ? `${daysAgoLabel}, ${habitName}`
    : `Future, ${habitName}`;
---

<form
  method="post"
  action={`/habits/${habitId}/complete`}
  class="contents"
  data-habit-checkbox
>
  <input type="hidden" name="date" value={dateStr} />
  <input type="hidden" name="done" value={done ? 'false' : 'true'} />
  <button
    type="submit"
    role="switch"
    aria-checked={done}
    aria-label={ariaLabel}
    disabled={!isPast && !isToday}
    data-done={done}
    data-habit-id={habitId}
    data-tick-date={isoDate}
    data-tick-done={done ? 'true' : 'false'}
    data-long-press-delay="200"
    class={[
      'inline-flex h-7 w-7 items-center justify-center rounded-md transition-colors',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
      done
        ? 'text-primary hover:text-primary/80'
        : 'text-muted-foreground/60 hover:text-muted-foreground',
      !isPast && !isToday ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer',
    ].join(' ')}
    title={ariaLabel}
  >
    {done ? (
      <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6L9 17l-5-5" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 opacity-40" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6L9 17l-5-5" />
      </svg>
    )}
  </button>
</form>

<style is:global>
  /* HabitCheckBox: icon-only toggle, no checkbox border.
     A greyed-out tick when not done and a teal tick when done.
     Matches the castor-main NiceGUI design (Material sym_o_check
     with keep-color) but keeps the un-ticked state as a faint tick
     rather than an X — Xs feel like a stream of errors when the user
     is falling behind on their habits. */
  [data-habit-checkbox] button[role="switch"] {
    appearance: none;
    -webkit-appearance: none;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  [data-habit-checkbox] button[role="switch"]:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
</style>
