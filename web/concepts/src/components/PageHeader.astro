---
/**
 * PageHeader — the canonical page header pattern.
 *
 * Every signed-in page renders its title block through this component
 * so the layout stays consistent:
 *
 *   [<back arrow>] <title>            <actions slot>
 *                 <subtitle?>
 *
 * - `back` is an href; when set, an icon-only ghost button is rendered
 *   to the left of the title.
 * - `actions` is a slot — pass right-aligned controls (a "New circle"
 *   button, a sort menu, an "Edit" button, etc.).
 * - `subtitle` is the small muted line under the title.
 *
 * Changes in the 2026-09-27 UI pass
 * -------------------------------
 * 1. The actions slot used to live in its own row *below* the title
 *    (`mt-4`), which is why the DesktopMenu hamburger appeared under
 *    the page title instead of beside it, and why pages with no
 *    actions still reserved a phantom empty row. Title and actions now
 *    share one flex row, baseline-aligned.
 * 2. The subtitle carried a hard-coded `ml-11` (44px) indent meant to
 *    clear a back arrow. On pages *without* a back arrow — /habits and
 *    /circles — that indented the subtitle 44px to the right of its
 *    own title (measured: h1 at x=272, subtitle at x=316). The indent
 *    is now conditional on the back arrow actually being present.
 */
import { buttonVariants } from './ui/button';

interface Props {
  title: string;
  subtitle?: string;
  back?: string | null;
  /** Optional decorative icon (e.g. crown for owned circle). */
  icon?: 'crown' | 'users' | 'shield' | 'settings' | 'home' | null;
}

const { title, subtitle = '', back = null, icon = null } = Astro.props;

const BACK_LABELS: Record<string, string> = {
  '/habits': 'habits',
  '/circles': 'circles',
  '/settings': 'settings',
  '/': 'home',
};
const backAriaLabel = back ? (BACK_LABELS[back] ?? 'previous page') : '';

// The back arrow is a real 32px hit target with an accessible name,
// rather than a bare "←" glyph that screen readers announced as
// "leftwards arrow" with no destination.
const backClasses = buttonVariants({ variant: 'ghost', size: 'icon' });
---

<header class="page-header">
  <div class="page-header__top">
    <div class="page-header__id">
      {back && (
        <a
          href={back}
          aria-label={`Back to ${backAriaLabel}`}
          class:list={['page-header__back', backClasses]}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
        </a>
      )}
      <div class="page-header__text">
        <h1 class="page-header__title">
          {icon && <span aria-hidden="true">{icon}</span>}
          <span class="truncate"><slot name="title">{title}</slot></span>
        </h1>
        {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
      </div>
    </div>

    <div class="page-header__actions">
      <slot name="actions" />
    </div>
  </div>
</header>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-header__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-header__id {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
  }

  /*
   * The back button is nudged left so its box optically aligns with the
   * title's cap-height rather than sitting 10px inside it.
   *
   * It also carries a larger arrow and a larger hit target. The glyph
   * was `h-4 w-4` inside a 40px `size="icon"` button, so it rendered
   * at 16px — the same visual weight as the small "From"/"To" labels
   * sitting beside it, which made the one control that tells you where
   * you came from read as the least important thing in the header.
   * 20px matches the stroke weight and cap-height of the 28px page
   * title, and 44px is the touch-target floor used by the habit tick
   * boxes, so the two most important controls on a page now share a
   * size. The rule below the SVG is why the markup no longer needs an
   * `h-4 w-4` class on the icon itself.
   */
  .page-header__back {
    margin-left: -0.5rem;
    margin-top: 0.125rem;
    color: var(--muted-foreground);
    width: 2.75rem;
    height: 2.75rem;
  }

  .page-header__back:hover {
    color: var(--foreground);
  }

  .page-header__back :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .page-header__text {
    min-width: 0;
  }

  .page-header__title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  /*
   * `margin-left` is set on the title block by the parent when a back
   * arrow is present (the arrow + its gap), so the subtitle always
   * aligns to the title's left edge and never to the page edge.
   */
  .page-header__id:has(.page-header__back) .page-header__text {
    margin-left: 0;
  }

  .page-header__subtitle {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .page-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /*
   * On phones the title and actions each want the full row. The title
   * keeps priority; the actions wrap beneath it, right-aligned.
   */
  @media (max-width: 480px) {
    .page-header__top {
      flex-wrap: wrap;
    }
  }
</style>
