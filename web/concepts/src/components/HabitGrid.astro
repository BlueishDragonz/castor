---
/**
 * HabitGrid — compact card rows matching main branch NiceGUI design.
 * 
 * Each habit = card row with:
 *   - Habit name (link to detail page) with drawsheet (Edit, Duplicate, Reorder, Archive)
 *   - 7 date columns with checkboxes
 *   - Optional streak badge (settings.INDEX_SHOW_HABIT_STREAK)
 *   - Optional total badge (settings.INDEX_SHOW_HABIT_COUNT)
 * Sticky date headers (weekday + day number)
 * Tag filter: pull-down chips at top-right, hidden by default, shown on scroll up
 * Mobile: horizontal scroll for date columns, habit name sticky left
 */
import HabitCheckBox from './HabitCheckBox.astro';
import { HabitContextSheet } from './HabitContextSheet.tsx';
import { HabitNoteRow } from './HabitNoteRow.tsx';
import { Badge } from './ui/badge';
import { cn } from '@/lib/utils';
import { localISO } from '@/lib/dates';

interface Habit {
  id: string;
  name: string;
  tags: string[];
  tickedDays: string[]; // ISO dates like '2025-01-15'
  notesByDate: Record<string, string>; // ISO date -> note text
  period?: { frequency: number; interval: 'day' | 'week' | 'month' } | null;
  status: string;
}

interface Props {
  habits: Habit[];
  days: Date[];
  showStreak?: boolean;   // Default: false (matches main branch setting)
  showTotal?: boolean;    // Default: false (matches main branch setting)
  showEveryDayStreaks?: boolean; // Default: false
  nameColumns?: number;   // Default: 5
  dateColumns?: number;   // Default: 7
  dateReverse?: boolean;  // Default: false
  enableTagFilter?: boolean;
  tagSelectionMode?: 'single' | 'multi'; // Default: 'multi'
  firstDayOfWeek?: number; // Default: 0 (Monday)
  alignToday?: number | null; // Default: null (no alignment)
  selectedTags?: string[];
}

const {
  habits,
  days,
  showStreak = false,
  showTotal = false,
  showEveryDayStreaks = false,
  nameColumns = 5,
  dateColumns = 7,
  dateReverse = false,
  enableTagFilter = true,
  tagSelectionMode = 'multi',
  firstDayOfWeek = 0,
  alignToday = null,
  selectedTags = [],
} = Astro.props;

const today = new Date();
today.setHours(0, 0, 0, 0);

// Sort days: most recent first (today first)
const sortedDays = [...days].sort((a, b) => b.getTime() - a.getTime());

// Get all unique tags from habits
const allTags = [...new Set(habits.flatMap(h => h.tags))].sort();

// Filter habits by selected tags
const filteredHabits = habits.filter(habit => {
  if (selectedTags.length === 0) return true;
  if (habit.tags.length === 0) {
    return selectedTags.includes('__untagged__');
  }
  return habit.tags.some(tag => selectedTags.includes(tag));
});

// Calculate streak for a habit
function calculateStreak(habit: Habit): number {
  if (!habit.period) return 0;
  
  const tickedSet = new Set(habit.tickedDays);
  let streak = 0;
  
  // Check consecutive days from most recent backwards
  for (const day of sortedDays) {
    const iso = localISO(day);
    if (tickedSet.has(iso)) {
      streak++;
    } else if (day.getTime() <= today.getTime()) {
      // Only break streak for past/present days, not future
      break;
    }
  }
  
  return streak;
}

// Calculate total completions in the visible window
function calculateTotal(habit: Habit): number {
  const tickedSet = new Set(habit.tickedDays);
  return sortedDays.filter(day => {
    const iso = localISO(day);
    return tickedSet.has(iso);
  }).length;
}

// Format date for display
function isToday(date: Date): boolean {
  return date.getTime() === today.getTime();
}

function isPast(date: Date): boolean {
  return date.getTime() <= today.getTime();
}

// Build URL with updated tag filter
function buildTagUrl(tag: string | null, action: 'add' | 'remove' | 'clear'): string {
  const params = new URLSearchParams(Astro.url.search);
  const current = params.getAll('tag');
  
  if (action === 'clear') {
    params.delete('tag');
  } else if (action === 'add' && tag) {
    if (!current.includes(tag)) {
      params.append('tag', tag);
    }
  } else if (action === 'remove' && tag) {
    const idx = current.indexOf(tag);
    if (idx >= 0) {
      current.splice(idx, 1);
      params.set('tag', current.join(','));
    }
  }
  
  return `${Astro.url.pathname}?${params.toString()}`;
}

function isTagSelected(tag: string): boolean {
  return selectedTags.includes(tag);
}

---
<!-- Pull-down Tag Filter (hidden by default, shown on scroll up) -->
{enableTagFilter && allTags.length > 0 && (
  <div    id="tag-filter"
    class="fixed top-16 right-4 z-40 hidden transition-opacity duration-200"
    role="group" 
    aria-label="Filter habits by tag"
    data-tag-filter
  >
    <div class="flex flex-wrap gap-1.5 justify-end w-[20rem] bg-background border border-border rounded-lg p-3 shadow-lg">
      <a
        href={buildTagUrl(null, 'clear')}
        class={cn(
          'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
          selectedTags.length === 0
            ? 'bg-primary text-primary-foreground'
            : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
        )}
        aria-pressed={selectedTags.length === 0}
      >
        All
      </a>
      {allTags.map(tag => (
        <a
          href={buildTagUrl(tag, isTagSelected(tag) ? 'remove' : 'add')}
          class={cn(
            'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
            isTagSelected(tag)
              ? 'bg-primary text-primary-foreground'
              : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
          )}
          aria-pressed={isTagSelected(tag)}
        >
          #{tag}
        </a>
      ))}
      {habits.some(h => h.tags.length === 0) && (
        <a
          href={buildTagUrl('__untagged__', isTagSelected('__untagged__') ? 'remove' : 'add')}
          class={cn(
            'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
            isTagSelected('__untagged__')
              ? 'bg-primary text-primary-foreground'
              : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
          )}
          aria-pressed={isTagSelected('__untagged__')}
        >
          Untagged
        </a>
      )}
    </div>
  </div>
)}

<!-- Sticky Date Headers (matching main branch design) -->
{/*
  The dogfood 2026-09-25 walkthrough found the date strip floated
  disconnected above the rows with a big gap (mt-6) and no visual
  band. We now wrap the strip in the same Card chrome as the habit
  rows below so the eye reads it as one continuous panel: header
  strip on top, divider, row cards. The grid is sticky so it stays
  pinned on scroll.
*/}
<div class="mt-4 rounded-lg border border-border bg-card overflow-hidden">
  {/* Day-of-week header strip — sticky on scroll, sits flush above the
      first habit row inside the same Card container so there's no gap.
      Was previously a separate div with its own border + rounded-t-lg
      and `mt-4`, leaving a visible gap above the first row. */}
  <div class="sticky top-0 z-20 bg-card/95 backdrop-blur-sm border-b border-border px-2 pt-2 pb-3">
  <div class="grid gap-x-1 px-2"
       style={`grid-template-columns: minmax(0, 1fr) repeat(${sortedDays.length}, 1.75rem) ${showStreak ? '2.75rem' : '0'} ${showTotal ? '2.75rem' : '0'}`}
       aria-hidden="true">
    {/* Empty first cell — habit name lives in the row cards, no
        subheader above it (the page heading already says "Habits"). */}
    <div style="grid-column: 1">
      {/* intentional spacer so the day cells align with the row cards' ticks */}
    </div>
    {/* Weekday + day number stacked, one column per day. Same horizontal
        alignment as the row tick cells below (justify-center + items-center). */}
    {sortedDays.map((day, i) => (
      <div class="flex flex-col items-center justify-center text-[10px] font-medium text-muted-foreground uppercase tracking-wider leading-tight"
           style={{ gridColumn: `${i + 2}` }}>
        <span>{day.toLocaleDateString('en-GB', { weekday: 'short' })}</span>
        <span class="text-[11px] font-semibold normal-case text-foreground/70">{day.getDate()}</span>
      </div>
    ))}
    {showStreak && (
      <div class="text-center text-[10px] font-medium text-muted-foreground uppercase tracking-wider" style={{ width: '2.75rem', gridColumn: `${sortedDays.length + 2}` }}>
        Stk
      </div>
    )}
    {showTotal && (
      <div class="text-center text-[10px] font-medium text-muted-foreground uppercase tracking-wider" style={{ width: '2.75rem', gridColumn: `${sortedDays.length + (showStreak ? 3 : 2)}` }}>
        Sum
      </div>
    )}
  </div>
</div>

<!-- Habit Grid: compact card rows inside the same container as the
     day-of-week header. The outer wrapper <div class="mt-4 rounded-lg ...">
     opened above the header strip closes after the rows + add-habit
     button below. -->
  <div role="list" aria-label="Habits">
    {filteredHabits.map(habit => {
      const streak = calculateStreak(habit);
      const total = calculateTotal(habit);

      return (
        <>
          <article class="border-t border-border bg-card p-2" role="listitem">
          <div class="grid items-center gap-x-1" style={`grid-template-columns: minmax(0, 1fr) repeat(${sortedDays.length}, 1.75rem) ${showStreak ? '2.75rem' : '0'} ${showTotal ? '2.75rem' : '0'}`}>
            {/* Habit name column - link with drawsheet. min-w-0 + truncate so
                long names ellipsise and the right-aligned tick icons keep
                their place on the right edge of the row. */}
            <div class="flex items-center gap-2 min-w-0 px-2 py-1" style="grid-column: 1">
              <a
                href={`/habits/${habit.id}`}
                class="font-medium truncate block hover:underline text-foreground"
                role="heading"
                aria-level="3"
                data-long-press-delay="150"
                data-habit-id={habit.id}
              >
                {habit.name}
              </a>
              {habit.tags.length > 0 && (
                <span class="flex flex-wrap gap-1 shrink-0" aria-label={`Tags: ${habit.tags.join(', ')}`}>
                  {habit.tags.map(tag => (
                    <Badge variant="outline" className="text-[10px] px-1.5 py-0.5 shrink-0">
                      #{tag}
                    </Badge>
                  ))}
                </span>
              )}
            </div>

            {/* Date columns — icon-only ticks, right-aligned to the
                row's right edge. No cell borders, no checkbox squares. */}
            {sortedDays.map(day => {
              const isoDate = localISO(day);
              const done = habit.tickedDays.includes(isoDate);
              const dayIsToday = isToday(day);
              const dayIsPast = isPast(day);

              return (
                <div class="relative flex items-center justify-center py-1"
                     role="gridcell"
                     aria-label={`${dayIsToday ? 'Today' : day.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}: ${done ? 'Done' : 'Not done'}`}
                     style={{ gridColumn: 'auto' }}>
                  <HabitCheckBox
                    habitId={habit.id}
                    habitName={habit.name}
                    date={day}
                    done={done}
                    isToday={dayIsToday}
                    isPast={dayIsPast}
                  />
                </div>
              );
            })}

            {/* Streak badge */}
            {showStreak && (
              <div class="flex items-center justify-center" style={{ width: '2.75rem' }}>
                {habit.period ? (
                  <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs" aria-label={`Current streak: ${streak} days`}>
                    {streak > 0 ? streak : '—'}
                  </Badge>
                ) : (
                  <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs text-muted-foreground" aria-label="No period set">
                    —
                  </Badge>
                )}
              </div>
            )}

            {/* Total badge */}
            {showTotal && (
              <div class="flex items-center justify-center" style={{ width: '2.75rem' }}>
                <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs" aria-label={`Total completions in view: ${total}`}>
                  {total}
                </Badge>
              </div>
            )}
          </div>
        </article>
       
                {/* Context Sheet for this habit — uncontrolled sheet with
                    its own trigger; long-press on the habit name triggers
                    it (see the script below). */}
                <HabitContextSheet
                  client:load
                  habitName={habit.name}
                  habitId={habit.id}
                >
                  <button
                    type="button"
                    id={`sheet-${habit.id}-trigger`}
                    aria-label={`Actions for ${habit.name}`}
                    class="sr-only"
                  >actions</button>
                </HabitContextSheet>

                {/* Notes dialog for this row — mounted per-habit, not per-tick.
                    Triggered by long-press or right-click on a tick cell
                    (custom event `castor:tick-longpress`). */}
                <HabitNoteRow
                  client:load
                  habitId={habit.id}
                  habitName={habit.name}
                  initialNotesByDate={habit.notesByDate || {}}
                  initialTickedDays={habit.tickedDays || []}
                />
              </>
    );
  })}
</div>

<!-- "+ Add habit" sits below the last card instead of in the page header
     so the calendar strip has breathing room and the row stays focused
     on habit names + ticks. -->
{filteredHabits.length > 0 && (
  <div class="mt-6 flex justify-center">
    {/*
      Slice 22x: "+ Add habit" was rendered as a React <Button asChild>
      wrapping a plain <a>, but inside a .astro file the Radix Slot
      doesn't merge the Button's cva classes onto the <a> child, so
      the link had no visible button styling. Use the same classes
      inline as a plain <a> — the shadcn Button's "outline" variant
      applies them via `buttonVariants`.
    */}
    <a
      href="/habits/new"
      class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium border border-border bg-background shadow-sm hover:bg-accent hover:text-accent-foreground transition-all h-10 px-4 py-2"
    >
      + Add habit
    </a>
  </div>
)}

{filteredHabits.length === 0 && habits.length > 0 && (
  <div class="text-center py-12 text-muted-foreground">
    <p>No habits match the current filter.</p>
    <a
      href={buildTagUrl(null, 'clear')}
      class="inline-block mt-2 text-sm text-primary underline hover:no-underline"
    >
      Clear filters
    </a>
  </div>
)}
</div>
{/* ^ closes the container <div class="mt-4 rounded-lg border border-border bg-card overflow-hidden"> opened above the day-of-week header strip. */}

<script>
  // Tag filter scroll behavior (D13 fix).
  // Visible when at the top, hidden when scrolling down (so it doesn't
  // cover content), re-shown when scrolling up (so the user can grab
  // a chip without scrolling back to the very top first).
  (() => {
    const filter = document.querySelector('[data-tag-filter]');
    if (!filter) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    function updateFilter() {
      const el = filter as HTMLElement;
      const scrollY = window.scrollY;
      const scrollingUp = scrollY < lastScrollY;

      if (scrollY === 0 || scrollingUp) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }

      lastScrollY = scrollY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateFilter);
        ticking = true;
      }
    }, { passive: true });
  })();
  
  // Long press / right click to open context sheet
  (() => {
    let pressTimer: ReturnType<typeof setTimeout> | null = null;
    const PRESS_DELAY = 150;

    document.querySelectorAll('a[data-long-press-delay]').forEach(link => {
      const habitId = link.getAttribute('data-habit-id');
      if (!habitId) return;

      const sheetTrigger = document.getElementById(`sheet-${habitId}-trigger`);

      const startPress = (e: MouseEvent | TouchEvent) => {
        if ('button' in e && e.button === 2) {
          // Right click - open immediately
          e.preventDefault();
          sheetTrigger?.click();
          return;
        }

        pressTimer = setTimeout(() => {
          sheetTrigger?.click();
        }, PRESS_DELAY);
      };

      const endPress = () => {
        if (pressTimer) {
          clearTimeout(pressTimer);
          pressTimer = null;
        }
      };

      link.addEventListener('mousedown', startPress as EventListener);
      link.addEventListener('mouseup', endPress);
      link.addEventListener('mouseleave', endPress);
      link.addEventListener('touchstart', startPress as EventListener, { passive: true });
      link.addEventListener('touchend', endPress);
      link.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        sheetTrigger?.click();
      });
    });
  })();

  // Long press / right click on a tick cell — opens the notes dialog
  // for that habit + date instead of submitting the toggle form.
  // Cast from castor-main: a tick cell is a button, but a 200ms hold
  // (or right-click) emits `castor:tick-longpress` so HabitNoteRow can
  // pop the notes modal. A short click still falls through to the
  // button's submit, which is the toggle path.
  (() => {
    let pressTimer: ReturnType<typeof setTimeout> | null = null;
    let suppressNextClick = false;
    const PRESS_DELAY = 200;

    const openNotes = (btn: HTMLElement) => {
      const habitId = btn.getAttribute('data-habit-id');
      const date = btn.getAttribute('data-tick-date');
      const doneStr = btn.getAttribute('data-tick-done') || 'false';
      if (!habitId || !date) return;
      document.dispatchEvent(new CustomEvent('castor:tick-longpress', {
        detail: { habitId, date, done: doneStr === 'true' },
      }));
    };

    const swallowNextClick = (btn: HTMLElement) => {
      // The browser fires a `click` after `mouseup`. Capturing it lets
      // us cancel the form submit that would otherwise flip the tick.
      const onClick = (e: Event) => {
        e.preventDefault();
        e.stopImmediatePropagation();
        suppressNextClick = false;
      };
      btn.addEventListener('click', onClick, { once: true, capture: true });
    };

    document.querySelectorAll('[data-habit-checkbox] button[data-long-press-delay]').forEach(btn => {
      const el = btn as HTMLElement;
      const startPress = (e: MouseEvent | TouchEvent) => {
        if ((el as HTMLButtonElement).disabled) return;
        if ('button' in e && e.button === 2) {
          e.preventDefault();
          openNotes(el);
          return;
        }
        suppressNextClick = false;
        pressTimer = setTimeout(() => {
          suppressNextClick = true;
          swallowNextClick(el);
          openNotes(el);
        }, PRESS_DELAY);
      };

      const endPress = () => {
        if (pressTimer) {
          clearTimeout(pressTimer);
          pressTimer = null;
        }
      };

      el.addEventListener('mousedown', startPress as EventListener);
      el.addEventListener('mouseup', endPress);
      el.addEventListener('mouseleave', endPress);
      el.addEventListener('touchstart', startPress as EventListener, { passive: true });
      el.addEventListener('touchend', endPress);
      el.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        openNotes(el);
      });
    });
  })();
</script>

<style is:global>
  /* Mobile horizontal scroll with sticky habit name */
  @media (max-width: 768px) {
    article > div {
      -webkit-overflow-scrolling: touch;
      overflow-x: auto;
    }
    
    article > div > div:first-child {
      position: sticky;
      left: 0;
      z-index: 10;
    }
    
    /* Reduce padding on mobile */
    article {
      padding: 0.75rem;
    }
  }
  
  /* Today column highlight: rendered on the button itself via
     `ring-2 ring-primary ring-offset-2` in HabitCheckBox. The gridcell
     wrapper intentionally has no fill — keep it that way so the
     `bg-primary` (and `bg-background`) classes on the button cascade
     without an extra pale tint fighting them. */

  /* Ensure habit cards have proper contrast.
     NOTE: these rules previously used `hsl(var(--card))` etc., which
     broke when --card migrated from a `H S L%` triple to a full
     `oklch(...)` value in the Tailwind v4 token swap (D5). Use the
     variable directly — it's already a valid CSS color. */
  article {
    background: var(--card);
    border-color: var(--border);
  }

  article > div > div:first-child {
    background: oklch(from var(--card) l c h / 0.95);
  }

  /* Sheet content styling */
  [data-radix-dialog-content] {
    background: var(--background);
  }
</style>