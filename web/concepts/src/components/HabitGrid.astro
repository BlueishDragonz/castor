---
/**
 * HabitGrid — compact card rows matching main branch NiceGUI design.
 * 
 * Each habit = card row with:
 *   - Habit name (link to detail page) with drawsheet (Edit, Duplicate, Reorder, Archive)
 *   - 7 date columns with checkboxes
 *   - Optional streak badge (settings.INDEX_SHOW_HABIT_STREAK)
 *   - Optional total badge (settings.INDEX_SHOW_HABIT_COUNT)
 * Sticky date headers (weekday + day number)
 * Tag filter: pull-down chips at top-right, hidden by default, shown on scroll up
 * Mobile: horizontal scroll for date columns, habit name sticky left
 */
import HabitCheckBox from './HabitCheckBox.astro';
import { HabitContextSheet } from './HabitContextSheet.tsx';
import { HabitNoteRow } from './HabitNoteRow.tsx';
import { Badge } from './ui/badge';
import { cn } from '@/lib/utils';
import { localISO } from '@/lib/dates';
import type { HabitPeriod } from '../lib/period';

interface Habit {
  id: string;
  name: string;
  tags: string[];
  tickedDays: string[]; // ISO dates like '2025-01-15'
  notesByDate: Record<string, string>; // ISO date -> note text
  period?: HabitPeriod | null;
  status: string;
}

interface Props {
  habits: Habit[];
  days: Date[];
  showStreak?: boolean;   // Default: false (matches main branch setting)
  showTotal?: boolean;    // Default: false (matches main branch setting)
  showEveryDayStreaks?: boolean; // Default: false
  nameColumns?: number;   // Default: 5
  dateColumns?: number;   // Default: 7
  dateReverse?: boolean;  // Default: false
  enableTagFilter?: boolean;
  tagSelectionMode?: 'single' | 'multi'; // Default: 'multi'
  firstDayOfWeek?: number; // Default: 0 (Monday)
  alignToday?: number | null; // Default: null (no alignment)
  selectedTags?: string[];
}

const {
  habits,
  days,
  showStreak = false,
  showTotal = false,
  showEveryDayStreaks = false,
  nameColumns = 5,
  dateColumns = 7,
  dateReverse = false,
  enableTagFilter = true,
  tagSelectionMode = 'multi',
  firstDayOfWeek = 0,
  alignToday = null,
  selectedTags = [],
} = Astro.props;

const today = new Date();
today.setHours(0, 0, 0, 0);

/*
 * Column geometry, shared by the header strip and every row so the two
 * can never drift apart. Exposed as CSS custom properties rather than
 * an inline `grid-template-columns` string that was duplicated in two
 * places (it had already drifted once).
 *
 * DAY_COL was 1.75rem (28px) — the bare minimum for a tap target on
 * desktop and below the 44px comfortable size on touch. It is now
 * 2.25rem (36px) desktop, widened further on coarse pointers.
 */
const DAY_COL = 36;
const BADGE_COL = 44;

// Sort days: most recent first (today first)
const sortedDays = [...days].sort((a, b) => b.getTime() - a.getTime());

// Get all unique tags from habits
const allTags = [...new Set(habits.flatMap(h => h.tags))].sort();

// Filter habits by selected tags
const filteredHabits = habits.filter(habit => {
  if (selectedTags.length === 0) return true;
  if (habit.tags.length === 0) {
    return selectedTags.includes('__untagged__');
  }
  return habit.tags.some(tag => selectedTags.includes(tag));
});

// Calculate streak for a habit
function calculateStreak(habit: Habit): number {
  if (!habit.period) return 0;
  
  const tickedSet = new Set(habit.tickedDays);
  let streak = 0;
  
  // Check consecutive days from most recent backwards
  for (const day of sortedDays) {
    const iso = localISO(day);
    if (tickedSet.has(iso)) {
      streak++;
    } else if (day.getTime() <= today.getTime()) {
      // Only break streak for past/present days, not future
      break;
    }
  }
  
  return streak;
}

// Calculate total completions in the visible window
function calculateTotal(habit: Habit): number {
  const tickedSet = new Set(habit.tickedDays);
  return sortedDays.filter(day => {
    const iso = localISO(day);
    return tickedSet.has(iso);
  }).length;
}

// Format date for display
function isToday(date: Date): boolean {
  return date.getTime() === today.getTime();
}

function isPast(date: Date): boolean {
  return date.getTime() <= today.getTime();
}

// Build URL with updated tag filter
function buildTagUrl(tag: string | null, action: 'add' | 'remove' | 'clear'): string {
  const params = new URLSearchParams(Astro.url.search);
  const current = params.getAll('tag');
  
  if (action === 'clear') {
    params.delete('tag');
  } else if (action === 'add' && tag) {
    if (!current.includes(tag)) {
      params.append('tag', tag);
    }
  } else if (action === 'remove' && tag) {
    const idx = current.indexOf(tag);
    if (idx >= 0) {
      current.splice(idx, 1);
      params.set('tag', current.join(','));
    }
  }
  
  return `${Astro.url.pathname}?${params.toString()}`;
}

function isTagSelected(tag: string): boolean {
  return selectedTags.includes(tag);
}

---
<!-- Pull-down Tag Filter (hidden by default, shown on scroll up) -->
{enableTagFilter && allTags.length > 0 && (
  <div    id="tag-filter"
    class="fixed top-16 right-4 z-40 hidden transition-opacity duration-200"
    role="group" 
    aria-label="Filter habits by tag"
    data-tag-filter
  >
    <div class="flex flex-wrap gap-1.5 justify-end w-[20rem] bg-background border border-border rounded-lg p-3 shadow-lg">
      <a
        href={buildTagUrl(null, 'clear')}
        class={cn(
          'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
          selectedTags.length === 0
            ? 'bg-primary text-primary-foreground'
            : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
        )}
        aria-pressed={selectedTags.length === 0}
      >
        All
      </a>
      {allTags.map(tag => (
        <a
          href={buildTagUrl(tag, isTagSelected(tag) ? 'remove' : 'add')}
          class={cn(
            'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
            isTagSelected(tag)
              ? 'bg-primary text-primary-foreground'
              : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
          )}
          aria-pressed={isTagSelected(tag)}
        >
          #{tag}
        </a>
      ))}
      {habits.some(h => h.tags.length === 0) && (
        <a
          href={buildTagUrl('__untagged__', isTagSelected('__untagged__') ? 'remove' : 'add')}
          class={cn(
            'px-2.5 py-1 text-xs font-medium rounded transition-colors shrink-0',
            isTagSelected('__untagged__')
              ? 'bg-primary text-primary-foreground'
              : 'bg-secondary text-secondary-foreground hover:bg-secondary/80'
          )}
          aria-pressed={isTagSelected('__untagged__')}
        >
          Untagged
        </a>
      )}
    </div>
  </div>
)}

<!-- Sticky Date Headers (matching main branch design) -->
{/*
  The dogfood 2026-09-25 walkthrough found the date strip floated
  disconnected above the rows with a big gap (mt-6) and no visual
  band. We now wrap the strip in the same Card chrome as the habit
  rows below so the eye reads it as one continuous panel: header
  strip on top, divider, row cards. The grid is sticky so it stays
  pinned on scroll.
*/}
<div class="habit-panel">
  {/* Day-of-week header strip — sits flush above the first habit row
      inside the same panel so there's no gap. */}
  <div class="habit-panel__head">
  <div class="habit-grid habit-grid--head"
       style={`--day-count:${sortedDays.length}; --day-min:${DAY_COL}px; --streak-col:${showStreak ? BADGE_COL + 'px' : '0px'}; --total-col:${showTotal ? BADGE_COL + 'px' : '0px'}`}
       aria-hidden="true">
    {/* The habit-name column carries a real label now. Previously the
        top-left of the grid was an empty spacer, which is why the
        panel read as "dates floating on the right" with no anchor. */}
    <div class="habit-grid__name habit-grid__name--head">Habit</div>
    {sortedDays.map((day) => (
      <div class:list={['habit-grid__day', isToday(day) && 'is-today']}>
        <span class="habit-grid__weekday">{day.toLocaleDateString('en-GB', { weekday: 'short' })}</span>
        <span class="habit-grid__daynum">{day.getDate()}</span>
        {isToday(day) && <span class="castor-sr-only">(today)</span>}
      </div>
    ))}
    {showStreak && <div class="habit-grid__badge">Streak</div>}
    {showTotal && <div class="habit-grid__badge">Total</div>}
  </div>
</div>

<!-- Habit Grid: compact card rows inside the same container as the
     day-of-week header. The outer wrapper <div class="mt-4 rounded-lg ...">
     opened above the header strip closes after the rows + add-habit
     button below. -->
  <div role="list" aria-label="Habits">
    {/*
      On a narrow viewport the seven date columns overflow the row and
      the oldest ones scroll out of view. The hint below is the
      non-decorative half of that affordance (the edge fade is the
      decorative half) and it is hidden on desktop, where all seven
      columns fit and the sentence would be noise.
    */}
    <p class="habit-panel__scroll-hint">
      Showing the {sortedDays.length} most recent days — swipe the row to see
      older dates.
    </p>
    {filteredHabits.map(habit => {
      const streak = calculateStreak(habit);
      const total = calculateTotal(habit);

      return (
        <>
          <article class="habit-row" role="listitem">
          <div class="habit-grid" style={`--day-count:${sortedDays.length}; --day-min:${DAY_COL}px; --streak-col:${showStreak ? BADGE_COL + 'px' : '0px'}; --total-col:${showTotal ? BADGE_COL + 'px' : '0px'}`}>
            {/* Habit name column — link to the detail page, with the
                context sheet attached. The name is the widest column so
                long habit names stay on one line; `minmax(0, 1fr)` on a
                fixed day-column track stops the day cells being squeezed
                when a long name is present. */}
            <div class="habit-grid__name">
              <a
                href={`/habits/${habit.id}`}
                class="habit-grid__link"
                role="heading"
                aria-level="3"
                data-long-press-delay="150"
                data-habit-id={habit.id}
              >
                {habit.name}
              </a>
              {habit.tags.length > 0 && (
                <span class="habit-grid__tags" aria-label={`Tags: ${habit.tags.join(', ')}`}>
                  {habit.tags.map(tag => (
                    <Badge variant="outline" className="habit-grid__tag">
                      {tag}
                    </Badge>
                  ))}
                </span>
              )}
            </div>

            {/* Date columns — one tick per day, aligned to the header
                strip above. The cell is the hit target; the tick glyph
                inside it is the state indicator. */}
            {sortedDays.map(day => {
              const isoDate = localISO(day);
              const done = habit.tickedDays.includes(isoDate);
              const dayIsToday = isToday(day);
              const dayIsPast = isPast(day);

              return (
                <div
                  class:list={['habit-grid__cell', dayIsToday && 'is-today']}
                  role="gridcell"
                  aria-label={`${dayIsToday ? 'Today' : day.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}: ${done ? 'Done' : 'Not done'}`}
                >
                  <HabitCheckBox
                    habitId={habit.id}
                    habitName={habit.name}
                    date={day}
                    done={done}
                    isToday={dayIsToday}
                    isPast={dayIsPast}
                  />
                </div>
              );
            })}

            {/* Streak badge */}
            {showStreak && (
              <div class="habit-grid__badge-cell">
                {habit.period ? (
                  <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs" aria-label={`Current streak: ${streak} days`}>
                    {streak > 0 ? streak : '—'}
                  </Badge>
                ) : (
                  <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs text-muted-foreground" aria-label="No period set">
                    —
                  </Badge>
                )}
              </div>
            )}

            {/* Total badge */}
            {showTotal && (
              <div class="habit-grid__badge-cell">
                <Badge variant="outline" className="w-full px-1.5 py-0.5 text-xs" aria-label={`Total completions in view: ${total}`}>
                  {total}
                </Badge>
              </div>
            )}
          </div>
        </article>
       
                {/* Context Sheet for this habit — uncontrolled sheet with
                    its own trigger; long-press on the habit name triggers
                    it (see the script below). */}
                <HabitContextSheet
                  client:load
                  habitName={habit.name}
                  habitId={habit.id}
                >
                  <button
                    type="button"
                    id={`sheet-${habit.id}-trigger`}
                    aria-label={`Actions for ${habit.name}`}
                    class="sr-only"
                  >actions</button>
                </HabitContextSheet>

                {/* Notes dialog for this row — mounted per-habit, not per-tick.
                    Triggered by long-press or right-click on a tick cell
                    (custom event `castor:tick-longpress`). */}
                <HabitNoteRow
                  client:load
                  habitId={habit.id}
                  habitName={habit.name}
                  initialNotesByDate={habit.notesByDate || {}}
                  initialTickedDays={habit.tickedDays || []}
                />
              </>
    );
  })}
</div>

{/*
  The "+ Add habit" button that used to sit centred below the last row
  is gone. It duplicated the "New habit" primary action in the page
  header, and placing it after the list made creating a habit the last
  thing a user would think of rather than the first. When the tag filter
  is hiding every habit, the filter panel below is the right next step.
*/}

{filteredHabits.length === 0 && habits.length > 0 && (
  <div class="habit-panel__empty">
    <p>No habits match the current filter.</p>
    <a href={buildTagUrl(null, 'clear')} class="habit-panel__clear">
      Clear filters
    </a>
  </div>
)}
</div>
{/* ^ closes the container <div class="mt-4 rounded-lg border border-border bg-card overflow-hidden"> opened above the day-of-week header strip. */}

<script>
  // Tag filter scroll behavior (D13 fix).
  // Visible when at the top, hidden when scrolling down (so it doesn't
  // cover content), re-shown when scrolling up (so the user can grab
  // a chip without scrolling back to the very top first).
  (() => {
    const filter = document.querySelector('[data-tag-filter]');
    if (!filter) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    function updateFilter() {
      const el = filter as HTMLElement;
      const scrollY = window.scrollY;
      const scrollingUp = scrollY < lastScrollY;

      if (scrollY === 0 || scrollingUp) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }

      lastScrollY = scrollY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateFilter);
        ticking = true;
      }
    }, { passive: true });
  })();
  
  // Long press / right click to open context sheet
  (() => {
    let pressTimer: ReturnType<typeof setTimeout> | null = null;
    const PRESS_DELAY = 150;

    document.querySelectorAll('a[data-long-press-delay]').forEach(link => {
      const habitId = link.getAttribute('data-habit-id');
      if (!habitId) return;

      const sheetTrigger = document.getElementById(`sheet-${habitId}-trigger`);

      const startPress = (e: MouseEvent | TouchEvent) => {
        if ('button' in e && e.button === 2) {
          // Right click - open immediately
          e.preventDefault();
          sheetTrigger?.click();
          return;
        }

        pressTimer = setTimeout(() => {
          sheetTrigger?.click();
        }, PRESS_DELAY);
      };

      const endPress = () => {
        if (pressTimer) {
          clearTimeout(pressTimer);
          pressTimer = null;
        }
      };

      link.addEventListener('mousedown', startPress as EventListener);
      link.addEventListener('mouseup', endPress);
      link.addEventListener('mouseleave', endPress);
      link.addEventListener('touchstart', startPress as EventListener, { passive: true });
      link.addEventListener('touchend', endPress);
      link.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        sheetTrigger?.click();
      });
    });
  })();

  // Long press / right click on a tick cell — opens the notes dialog
  // for that habit + date instead of submitting the toggle form.
  // Cast from castor-main: a tick cell is a button, but a 200ms hold
  // (or right-click) emits `castor:tick-longpress` so HabitNoteRow can
  // pop the notes modal. A short click still falls through to the
  // button's submit, which is the toggle path.
  (() => {
    let pressTimer: ReturnType<typeof setTimeout> | null = null;
    let suppressNextClick = false;
    const PRESS_DELAY = 200;

    const openNotes = (btn: HTMLElement) => {
      const habitId = btn.getAttribute('data-habit-id');
      const date = btn.getAttribute('data-tick-date');
      const doneStr = btn.getAttribute('data-tick-done') || 'false';
      if (!habitId || !date) return;
      document.dispatchEvent(new CustomEvent('castor:tick-longpress', {
        detail: { habitId, date, done: doneStr === 'true' },
      }));
    };

    const swallowNextClick = (btn: HTMLElement) => {
      // The browser fires a `click` after `mouseup`. Capturing it lets
      // us cancel the form submit that would otherwise flip the tick.
      const onClick = (e: Event) => {
        e.preventDefault();
        e.stopImmediatePropagation();
        suppressNextClick = false;
      };
      btn.addEventListener('click', onClick, { once: true, capture: true });
    };

    document.querySelectorAll('[data-habit-checkbox] button[data-long-press-delay]').forEach(btn => {
      const el = btn as HTMLElement;
      const startPress = (e: MouseEvent | TouchEvent) => {
        if ((el as HTMLButtonElement).disabled) return;
        if ('button' in e && e.button === 2) {
          e.preventDefault();
          openNotes(el);
          return;
        }
        suppressNextClick = false;
        pressTimer = setTimeout(() => {
          suppressNextClick = true;
          swallowNextClick(el);
          openNotes(el);
        }, PRESS_DELAY);
      };

      const endPress = () => {
        if (pressTimer) {
          clearTimeout(pressTimer);
          pressTimer = null;
        }
      };

      el.addEventListener('mousedown', startPress as EventListener);
      el.addEventListener('mouseup', endPress);
      el.addEventListener('mouseleave', endPress);
      el.addEventListener('touchstart', startPress as EventListener, { passive: true });
      el.addEventListener('touchend', endPress);
      el.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        openNotes(el);
      });
    });
  })();
</script>

<style>
  /*
   * ─── Panel ──────────────────────────────────────────────────────
   * One bordered surface containing the header strip and every row.
   * Rows are separated by hairlines rather than each being its own
   * card, so the grid reads as a single table instead of a stack of
   * unrelated panels.
   */
  .habit-panel {
    /*
     * Fill the page column, edge to edge.
     *
     * This used to be `width: fit-content` + `margin-inline: auto`,
     * chosen to avoid a wide empty band on the right. But a habit
     * tracker is a *table* — a reader scanning down the rows wants
     * the name column and the date columns to line up with the rest
     * of the page, not to float in a narrower island inside it. The
     * day tracks are now flexible (1fr) instead of a fixed px width,
     * so filling the row adds breathing space between days rather
     * than stretching the tick controls. The panel's outer edges line
     * up with the page header's title and every card on /settings and
     * /security, which is the whole point of the shared .castor-page
     * column.
     */
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
    overflow: hidden;
  }

  .habit-panel__head {
    border-bottom: 1px solid var(--border);
    background: var(--muted);
  }

  /*
   * ─── Grid ───────────────────────────────────────────────────────
   * `--day-min` and `--badge-col` are set inline per grid so the header
   * strip and the rows are guaranteed to share identical track sizes —
   * the duplicated inline `grid-template-columns` string they replaced
   * had already drifted once, putting the date headers out of register
   * with the ticks below them.
   *
   * Inline styles beat stylesheet rules, so the inline value is the
   * track's *minimum* (`--day-min`) rather than a finished `--day-col`.
   * The desktop rule below composes it into a flexible
   * `minmax(var(--day-min), 1fr)`; the mobile media query further down
   * overrides `--day-col` outright with a fixed 44px, because on a
   * phone the columns must not stretch — the row scrolls instead.
   *
   * The name column is `minmax(0, 1.6fr)`: a larger share of the row
   * than the days, so long habit names stop truncating, while still
   * shrinking before the day columns do. The earlier 22rem cap
   * truncated names on a wide window and left a dead gap between each
   * name and its own dates.
   */
  /*
   * The header strip and the rows must share one horizontal origin.
   * They previously differed: the header grid carried `padding: 0
   * 0.5rem` while the row grids did not, so every date header sat 8px
   * to the right of the checkbox it labelled (measured: header day at
   * x=721, row cell at x=713). The padding now lives on the shared
   * name-cell rule, which both the header and the rows use.
   */
  .habit-grid {
    /*
     * Desktop tracks.
     *
     * The day columns are `minmax(--day-min, 1fr)` and the name takes a
     * 4fr share, so the name always wins the leftover width and the day
     * squares stay around 70px — wide enough for a comfortable tap
     * target without becoming the dominant element.
     *
     * The 4fr:1fr ratio and the 0.375rem gap are tuned together. A first
     * pass used 3fr with a 0.75rem gap, which put too much air between
     * the dates (the columns read as separate cards rather than one
     * calendar) and left the habit name the tightest thing on the row.
     * Halving the gap to 0.375rem freed ~36px across the row, and
     * raising the name's share from 3fr to 4fr moves that width into the
     * name column instead of letting the day columns absorb it.
     */
    --name-col: minmax(0, 4fr);
    --day-col: minmax(var(--day-min, 40px), 1fr);
    display: grid;
    grid-template-columns:
      var(--name-col)
      repeat(var(--day-count, 7), var(--day-col))
      var(--streak-col, 0px)
      var(--total-col, 0px);
    align-items: center;
    gap: 0.375rem;
  }

  .habit-grid__name {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.625rem 0.75rem;
  }

  .habit-grid__name--head {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .habit-grid__link {
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    min-width: 0;
    /* The name outranks its tags for space (see .habit-grid__tags). */
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .habit-grid__link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /*
   * Tags sit to the right of the habit name in the same cell. They
   * must never take priority: this used to be `flex-shrink: 0` next to
   * `min-width: 0`, and the two contradict each other — the tags
   * refused to shrink, so a habit tagged "mindfulness" pushed its own
   * name down to 46px and the name truncated to "Writ…" while the tag
   * stayed fully readable (measured at a 212px name cell). The name is
   * the primary identifier and is a link to the habit; a tag is
   * secondary metadata. So the tag group is the thing that yields:
   * shrinkable, and clipped by its own overflow, while the name link
   * keeps the space it needs.
   */
  .habit-grid__tags {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
  }

  .habit-grid__tag {
    font-size: 0.6875rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  /*
   * ─── Day columns ────────────────────────────────────────────────
   */
  .habit-grid__day {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0 0.375rem;
    line-height: 1.15;
  }

  .habit-grid__weekday {
    font-size: 0.6875rem;
