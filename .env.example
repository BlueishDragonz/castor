# Copy to .env for local development. Real secrets live only in
# /app/.user/.secrets.env inside the production container (mounted volume);
# NEVER commit real secrets here.

# ─── Core ────────────────────────────────────────────────────────────
DEBUG=false
# APP_URL=
# SENTRY_DSN=
# ADMIN_EMAIL=             # account that gets the /admin surface

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-chars-minimum-secret-value
JWT_LIFETIME_SECONDS=2592000
RESET_PASSWORD_TOKEN_SECRET=change-me-too-a-long-random-value
NICEGUI_STORAGE_SECRET=change-me-storage-secret-value
REQUIRE_ADMIN_FOR_REGISTRATION=false
# TRUSTED_EMAIL_HEADER=     # behind a trusted reverse proxy that sets email
# TRUSTED_EMAIL=
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8080

# ─── Rate limits (defaults: 120/300 API, 60 auth) ───────────────────
# API_RATE_USER_PER_MINUTE=120
# API_RATE_IP_PER_MINUTE=300
# AUTH_RATE_IP_PER_MINUTE=60

# ─── SMTP — outbound email (circles invites, account emails) ────────
# Empty SMTP_HOST keeps the legacy smtp.gmail.com:465 SSL fallback
# (username/password must then be Gmail credentials).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_EMAIL_USERNAME=
# SMTP_EMAIL_PASSWORD=
# SMTP_FROM=Castor <noreply@castor.example>

# ─── Frontend routing (Docker / production) ────────────────────────
# BACKEND_URL=http://127.0.0.1:8081      # Astro BFF → backend
# FRONTEND_URL=http://10.8.0.1:8080       # origin clients hit; invite links
# HABITS_STORAGE=DATABASE                  # or USER_DISK
# MAX_USER_COUNT=-1
# MAX_HABIT_COUNT=5
